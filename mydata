function cubicBezier(t, p0, p1, p2, p3) {
    var u = 1 - t;
    var tt = t * t;
    var uu = u * u;
    var uuu = uu * u;
    var ttt = tt * t;

    var p = [0, 0];
    p[0] = uuu * p0[0] + 3 * uu * t * p1[0] + 3 * u * tt * p2[0] + ttt * p3[0];
    p[1] = uuu * p0[1] + 3 * uu * t * p1[1] + 3 * u * tt * p2[1] + ttt * p3[1];
    
    return p;
}


    function mapValue(value, min, max, outputMin, outputMax) {
                            //映射函数（源值，源值最小，源值最大，映射最小，映射最大）
                            // 计算输入值的比例
                            var range = max - min;
                            // 计算输出值的范围
                            var outputRange = outputMax - outputMin;
                            var normalizedValue = (value - min) / range;
                            // 计算当前值的映射
                            var mappedValue = outputMin + normalizedValue * outputRange;
                            return mappedValue;
                    }

    function speed(diff,value1,value2){
                                    var lsbl = 0;
                                    for (i = 0; i < value2.length; i++){
                                        lsbl = lsbl + (value2[i]- value1[i]) * (value2[i] - value1[i]);
                                    }
                                    return (Math.sqrt(lsbl))/diff;
                        }

function Curve_get(zuo_influence, you_influence, spline_size_min, spline_size_max, p1, p2) {
    var comp = app.project.activeItem;
    
    // 检查有效性
    if (!comp || !(comp instanceof CompItem) || comp.selectedLayers.length === 0) {
        alert("请选择至少一个图层");
        return null;
    }

    app.beginUndoGroup('曲线优化');

    try {
        var curve_controller = [];
        
        // 定义属性类型常量
        const PROPERTY_TYPES = {
            POSITION: ["ADBE Position", "ADBE Position_0"],
            SCALE: ["ADBE Scale"],
            ANCHOR_POINT: ["ADBE AnchorPoint"],
            ROTATION: ["ADBE Rotation", "ADBE Rotation_0", "ADBE Rotate Z"],
            OPACITY: ["ADBE Opacity"],
            PATH: ["ADBE Mask Shape", "ADBE Path", "ADBE Vector Shape"]
        };

        // 处理所有选中图层
        for (var z = 0; z < comp.selectedLayers.length; z++) {
            var selectedLayer = comp.selectedLayers[z];
            var selectedProperties = selectedLayer.selectedProperties;

            for (var p = 0; p < selectedProperties.length; p++) {
                var property = selectedProperties[p];
                var result = processProperty(property);
                if (result) {
                    curve_controller.push(result);
                }
            }
        }

        // 如果只需要计算速度而不实际修改关键帧，直接返回计算结果
        if (p1 === undefined && p2 === undefined) {
            return curve_controller.length > 0 ? curve_controller[0] : null;
        }

        // 保存设置（只有在实际修改关键帧时才保存）
        if (typeof main_spline !== 'undefined' && main_spline.state) {
            app.settings.saveSetting("贝塞尔曲线", "Preset0", JSON.stringify(main_spline.state));
        }

        return curve_controller.length > 0 ? curve_controller[0] : null;

    } catch (error) {
        alert("处理过程中出现错误: " + error.toString());
        return null;
    } finally {
        app.endUndoGroup();
    }

    // 处理属性函数
    function processProperty(property) {
        var propertyType = getPropertyType(property);
        
        if (!propertyType) return null;

        var keyPairs = getKeyframePairs(property);
        
        for (var i = 0; i < keyPairs.length; i++) {
            var keyPair = keyPairs[i];
            var result = applyCurveToKeyframes(property, propertyType, keyPair);
            if (result && !p1 && !p2) {
                return result; // 只返回第一个关键帧对的计算结果
            }
        }
        return null;
    }

    // 获取属性类型
    function getPropertyType(property) {
        var matchName = property.matchName;
        
        for (var type in PROPERTY_TYPES) {
            if (PROPERTY_TYPES.hasOwnProperty(type)) {
                var typeArray = PROPERTY_TYPES[type];
                for (var i = 0; i < typeArray.length; i++) {
                    if (typeArray[i] === matchName) {
                        return type;
                    }
                }
            }
        }
        
        // 备用判断：根据属性值类型
        if (property.propertyValueType === PropertyValueType.TwoD_SPATIAL || 
            property.propertyValueType === PropertyValueType.ThreeD_SPATIAL) {
            return "SPATIAL";
        } else if (property.propertyValueType === PropertyValueType.TwoD) {
            return "TWO_D";
        } else if (property.propertyValueType === PropertyValueType.ThreeD) {
            return "THREE_D";
        } else if (property.propertyValueType === PropertyValueType.OneD) {
            return "ONE_D";
        } else if (property.propertyValueType === PropertyValueType.COLOR) {
            return "COLOR";
        } else if (property.propertyValueType === PropertyValueType.SHAPE) {
            return "SHAPE";
        }
        
        return null;
    }

    // 获取关键帧对
    function getKeyframePairs(property) {
        var keyPairs = [];
        var selectedKeys = property.selectedKeys;
        var numKeys = property.numKeys;

        if (selectedKeys.length >= 2) {
            // 使用选中的关键帧
            for (var j = 1; j < selectedKeys.length; j++) {
                keyPairs.push([selectedKeys[j-1], selectedKeys[j]]);
            }
        } else if (numKeys >= 2) {
            // 使用所有关键帧
            for (var j = 1; j < numKeys; j++) {
                keyPairs.push([j, j+1]);
            }
        }

        return keyPairs;
    }

    // 应用曲线到关键帧
    function applyCurveToKeyframes(property, propertyType, keyIndex) {
        try {
            var keyIndex0 = keyIndex[0];
            var keyIndex1 = keyIndex[1];
            
            var timeDiff = property.keyTime(keyIndex1) - property.keyTime(keyIndex0);
            var R_time_diff = mapValue(zuo_influence, 0.1, 100, timeDiff * 0.001, timeDiff);
            var L_time_diff = mapValue(you_influence, 0.1, 100, timeDiff * 0.001, timeDiff);

            switch(propertyType) {
                case "POSITION":
                case "ANCHOR_POINT":
                case "SPATIAL":
                    return handleSpatialProperty(property, keyIndex0, keyIndex1, R_time_diff, L_time_diff);
                    
                case "SCALE":
                case "THREE_D":
                    return handleScaleProperty(property, keyIndex0, keyIndex1, R_time_diff, L_time_diff);
                    
                case "ROTATION":
                case "OPACITY":
                case "ONE_D":
                    return handleOneDProperty(property, keyIndex0, keyIndex1, R_time_diff, L_time_diff);
                    
                case "PATH":
                case "SHAPE":
                    return handlePathProperty(property, keyIndex0, keyIndex1, R_time_diff, L_time_diff);
                    
                case "TWO_D":
                    return handleTwoDProperty(property, keyIndex0, keyIndex1, R_time_diff, L_time_diff);
                    
                default:
                    return handleGenericProperty(property, keyIndex0, keyIndex1, R_time_diff, L_time_diff);
            }
        } catch (error) {
            return null;
        }
    }

    // 处理空间属性（位置、锚点等）
    function handleSpatialProperty(property, keyIndex0, keyIndex1, R_time_diff, L_time_diff) {
        var value1 = property.keyValue(keyIndex0);
        var value2 = property.keyValue(keyIndex1);
        
        if (!p1) {
            // 只计算速度，不修改关键帧
            var speedOut = calculateSpeed(R_time_diff, value1, value2);
            var speedIn = calculateSpeed(L_time_diff, value1, value2);
            return [speedOut, speedIn];
        }

        var curve_zuo_max = mapValue(p1[1], spline_size_max, spline_size_min, 0, calculateSpeed(R_time_diff, value1, value2));
        var curve_you_max = mapValue(p2[1], spline_size_min, spline_size_max, 0, calculateSpeed(L_time_diff, value1, value2));

        // 处理第一个关键帧（出点）
        var outEase = property.keyOutTemporalEase(keyIndex0);
        var newOutEase = createEaseArray(outEase, curve_zuo_max, zuo_influence);
        property.setTemporalEaseAtKey(keyIndex0, property.keyInTemporalEase(keyIndex0), newOutEase);

        // 处理第二个关键帧（入点）
        var inEase = property.keyInTemporalEase(keyIndex1);
        var newInEase = createEaseArray(inEase, curve_you_max, you_influence);
        property.setTemporalEaseAtKey(keyIndex1, newInEase, property.keyOutTemporalEase(keyIndex1));
        
        return [curve_zuo_max, curve_you_max];
    }

    // 处理缩放属性
    function handleScaleProperty(property, keyIndex0, keyIndex1, R_time_diff, L_time_diff) {
        var value1 = property.keyValue(keyIndex0);
        var value2 = property.keyValue(keyIndex1);
        var dimensions = value2.length;

        if (!p1) {
            // 只计算速度，不修改关键帧
            var speeds = [];
            for (var i = 0; i < dimensions; i++) {
                speeds.push((value2[i] - value1[i]) / R_time_diff);
            }
            return speeds;
        }

        // 处理每个维度的缓动
        var newOutEase = [];
        var newInEase = [];
        var resultSpeeds = [];
        
        for (var i = 0; i < dimensions; i++) {
            var speedVal = (value2[i] - value1[i]) / R_time_diff;
            var curve_zuo_max = mapValue(p1[1], spline_size_max, spline_size_min, 0, speedVal);
            var curve_you_max = mapValue(p2[1], spline_size_min, spline_size_max, 0, speedVal);
            
            var outEase = property.keyOutTemporalEase(keyIndex0)[i];
            var inEase = property.keyInTemporalEase(keyIndex1)[i];
            
            newOutEase.push(new KeyframeEase(curve_zuo_max, zuo_influence));
            newInEase.push(new KeyframeEase(curve_you_max, you_influence));
            resultSpeeds.push([curve_zuo_max, curve_you_max]);
        }

        property.setTemporalEaseAtKey(keyIndex0, property.keyInTemporalEase(keyIndex0), newOutEase);
        property.setTemporalEaseAtKey(keyIndex1, newInEase, property.keyOutTemporalEase(keyIndex1));
        
        return resultSpeeds;
    }

    // 处理一维属性（旋转、透明度等）
    function handleOneDProperty(property, keyIndex0, keyIndex1, R_time_diff, L_time_diff) {
        var value1 = property.keyValue(keyIndex0);
        var value2 = property.keyValue(keyIndex1);
        
        if (!p1) {
            // 只计算速度，不修改关键帧
            var speedOut = (value2 - value1) / R_time_diff;
            var speedIn = (value2 - value1) / L_time_diff;
            return [speedOut, speedIn];
        }

        var curve_zuo_max = mapValue(p1[1], spline_size_max, spline_size_min, 0, (value2 - value1) / R_time_diff);
        var curve_you_max = mapValue(p2[1], spline_size_min, spline_size_max, 0, (value2 - value1) / L_time_diff);

        var outEase = new KeyframeEase(curve_zuo_max, zuo_influence);
        var inEase = new KeyframeEase(curve_you_max, you_influence);

        property.setTemporalEaseAtKey(keyIndex0, property.keyInTemporalEase(keyIndex0), [outEase]);
        property.setTemporalEaseAtKey(keyIndex1, [inEase], property.keyOutTemporalEase(keyIndex1));
        
        return [curve_zuo_max, curve_you_max];
    }

    // 处理路径属性
    function handlePathProperty(property, keyIndex0, keyIndex1, R_time_diff, L_time_diff) {
        var timeDiff = property.keyTime(keyIndex1) - property.keyTime(keyIndex0);
        
        if (!p1) {
            // 只计算速度，不修改关键帧
            return [1000, 1000];
        }

        var curve_zuo_max = mapValue(p1[1], spline_size_max, spline_size_min, timeDiff * 0.001, 1000);
        var curve_you_max = mapValue(p2[1], spline_size_min, spline_size_max, timeDiff * 0.001, 1000);

        var outEase = new KeyframeEase(curve_zuo_max, zuo_influence);
        var inEase = new KeyframeEase(curve_you_max, you_influence);

        property.setTemporalEaseAtKey(keyIndex0, property.keyInTemporalEase(keyIndex0), [outEase]);
        property.setTemporalEaseAtKey(keyIndex1, [inEase], property.keyOutTemporalEase(keyIndex1));
        
        return [curve_zuo_max, curve_you_max];
    }

    // 处理二维属性
    function handleTwoDProperty(property, keyIndex0, keyIndex1, R_time_diff, L_time_diff) {
        var value1 = property.keyValue(keyIndex0);
        var value2 = property.keyValue(keyIndex1);

        if (!p1) {
            // 只计算速度，不修改关键帧
            var speeds = [
                (value2[0] - value1[0]) / R_time_diff,
                (value2[1] - value1[1]) / R_time_diff
            ];
            return speeds;
        }

        var newOutEase = [];
        var newInEase = [];
        var resultSpeeds = [];

        for (var i = 0; i < 2; i++) {
            var speedVal = (value2[i] - value1[i]) / R_time_diff;
            var curve_zuo_max = mapValue(p1[1], spline_size_max, spline_size_min, 0, speedVal);
            var curve_you_max = mapValue(p2[1], spline_size_min, spline_size_max, 0, speedVal);

            newOutEase.push(new KeyframeEase(curve_zuo_max, zuo_influence));
            newInEase.push(new KeyframeEase(curve_you_max, you_influence));
            resultSpeeds.push([curve_zuo_max, curve_you_max]);
        }

        property.setTemporalEaseAtKey(keyIndex0, property.keyInTemporalEase(keyIndex0), newOutEase);
        property.setTemporalEaseAtKey(keyIndex1, newInEase, property.keyOutTemporalEase(keyIndex1));
        
        return resultSpeeds;
    }

    // 通用属性处理
    function handleGenericProperty(property, keyIndex0, keyIndex1, R_time_diff, L_time_diff) {
        // 默认处理方式
        return handleOneDProperty(property, keyIndex0, keyIndex1, R_time_diff, L_time_diff);
    }

    // 工具函数
    function calculateSpeed(timeDiff, value1, value2) {
        if (value1 instanceof Array && value2 instanceof Array) {
            // 计算向量的平均速度
            var totalDiff = 0;
            for (var i = 0; i < value1.length; i++) {
                totalDiff += Math.abs(value2[i] - value1[i]);
            }
            return totalDiff / value1.length / timeDiff;
        } else {
            return Math.abs(value2 - value1) / timeDiff;
        }
    }

    function createEaseArray(easeArray, speed, influence) {
        if (!(easeArray instanceof Array)) {
            easeArray = [easeArray];
        }
        
        var newEaseArray = [];
        for (var i = 0; i < easeArray.length; i++) {
            newEaseArray.push(new KeyframeEase(speed, influence));
        }
        return newEaseArray;
    }

    function mapValue(value, inMin, inMax, outMin, outMax) {
        return (value - inMin) * (outMax - outMin) / (inMax - inMin) + outMin;
    }
}
return palette;
}

