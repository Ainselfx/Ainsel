    // ========== UI创建 ==========
    function createUI(parent) {
        var isPanel = !(parent instanceof Panel);
        var win = parent instanceof Panel ? parent : new Window("palette", SCRIPT_NAME, undefined);
        
        if (!win) return null;
        
        var ui = win.add("group { orientation:'column', alignment:['left','top'], alignChildren:['left','top'] }");
        
        // 自动排列选项
        ui.arrangeCheck = ui.add("checkbox", undefined, "自动整理图层在Z轴上的位置");
        ui.arrangeCheck.value = config.autoArrange;
        ui.arrangeCheck.onClick = function() {
            config.autoArrange = this.value;
            ui.rangeGroup.enabled = ui.randomGroup.enabled = config.autoArrange;
            saveSetting("_AutoArrange", config.autoArrange);
        };
        
        // 分布类型
        ui.randomGroup = ui.add("group { orientation:'row' }");
        ui.randomGroup.add("statictext", undefined, "分布类型:");
        ui.randomGroup.distributeDropDown = ui.randomGroup.add("dropdownlist", undefined, DISTRIBUTION_TYPES);
        ui.randomGroup.distributeDropDown.selection = config.distributionIndex;
        ui.randomGroup.distributeDropDown.onChange = function() {
            config.distributionIndex = this.selection.index;
            saveSetting("_LayerDistribution", config.distributionIndex);
        };
        ui.randomGroup.enabled = config.autoArrange;
        
        // 范围设置
        ui.rangeGroup = ui.add("group { orientation:'row' }");
        ui.rangeGroup.add("statictext", undefined, "前面:");
        ui.rangeGroup.frontET = ui.rangeGroup.add("edittext", undefined, config.rangeFront.toString());
        ui.rangeGroup.frontET.characters = 5;
        ui.rangeGroup.add("statictext", undefined, "后面:");
        ui.rangeGroup.backET = ui.rangeGroup.add("edittext", undefined, config.rangeBack.toString());
        ui.rangeGroup.backET.characters = 5;
        
        ui.rangeGroup.frontET.onChange = function() {
            var val = parseInt(this.text, 10);
            if (!isNaN(val)) {
                config.rangeFront = val;
                saveSetting("_FrontRange", val);
            } else {
                this.text = config.rangeFront.toString();
            }
        };
        
        ui.rangeGroup.backET.onChange = function() {
            var val = parseInt(this.text, 10);
            if (!isNaN(val)) {
                config.rangeBack = val;
                saveSetting("_BackRange", val);
            } else {
                this.text = config.rangeBack.toString();
            }
        };
        
        ui.rangeGroup.enabled = config.autoArrange;
        
        // 空控制器
        ui.nullCheck = ui.add("checkbox", undefined, "始终使用空控制器");
        ui.nullCheck.value = config.useNullControllers;
        ui.nullCheck.onClick = function() {
            config.useNullControllers = this.value;
            saveSetting("_NullControllers", config.useNullControllers);
        };
        
        // 节点类型
        ui.nodeDropDown = ui.add("dropdownlist", undefined, NODE_TYPES);
        ui.nodeDropDown.selection = config.nodeIndex;
        ui.nodeDropDown.onChange = function() {
            config.nodeIndex = this.selection.index;
            saveSetting("_NodeIndex", config.nodeIndex);
        };
        
        // 镜头预设
        ui.lensGroup = ui.add("group { orientation:'row', alignment:['fill','top'] }");
        ui.lensGroup.add("statictext", undefined, "镜头预设:");
        ui.lensGroup.lensDropDown = ui.lensGroup.add("dropdownlist", undefined, LENS_PRESETS);
        ui.lensGroup.lensDropDown.selection = config.lensIndex;
        ui.lensGroup.lensDropDown.onChange = function() {
            config.lensIndex = this.selection.index;
            saveSetting("_LensPreset", config.lensIndex);
        };
        
        // 应用按钮
        ui.applyBtn = ui.add("button", undefined, "应用多平面");
        ui.applyBtn.alignment = ['fill', 'center'];
        ui.applyBtn.onClick = applyMultiplane;
        
        // 底部按钮组
        ui.bottomGroup = ui.add("group { orientation:'row', alignment:['fill','center'] }");
        ui.bottomGroup.helpBtn = ui.bottomGroup.add("button", undefined, "帮助");
        ui.bottomGroup.helpBtn.maximumSize = [40, 30];
        ui.bottomGroup.bakeBtn = ui.bottomGroup.add("button", undefined, "烘焙/移除");
        ui.bottomGroup.bakeBtn.alignment = ['fill', 'center'];
        
        ui.bottomGroup.helpBtn.onClick = showHelp;
        ui.bottomGroup.bakeBtn.onClick = bakeMultiplane;
        
        // 调整按钮高度
        var btnHeight = ui.applyBtn.preferredSize.height * 1.25;
        ui.bottomGroup.helpBtn.preferredSize.height = btnHeight;
        ui.bottomGroup.bakeBtn.preferredSize.height = btnHeight;
        ui.applyBtn.preferredSize.height = btnHeight;
        
        return win;
