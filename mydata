    function FixAngle_As(targetObj, i, mario, filet, parent_as) {
        var def = calque.position.value;
        if (i != parent_as.length - 1) {
            var x1 = parent_as[i].position.value[0];
            var y1 = parent_as[i].position.value[1];
        } else {
            var x1 = parent_as[parent_as.length - 2].position.value[0];
            var y1 = parent_as[parent_as.length - 2].position.value[1];
        }
        if (i != parent_as.length - 1) {
            var x2 = parent_as[i + 1].position.value[0];
            var y2 = parent_as[i + 1].position.value[1];
        } else {
            var x2 = parent_as[parent_as.length - 1].position.value[0];
            var y2 = parent_as[parent_as.length - 1].position.value[1];
        }
        var x = x2 - x1;
        var y = y2 - y1;
        var radian = Math.atan2(y, x);
        angle = (radian * 180) / Math.PI;
        if (angle > 0) {
            angle -= 360;
        }
        if (angle < 0) {
            angle += 360;
        }
        Math.ceil(angle);
        var angle2 = 0;
        if (angle < 0) {
            angle2 = angle + 90;
        } else {
            angle2 = angle - 90;
        }
        if (angle == 180) {
            angle = 0;
        }
        if (i == 0) {
            ControlLay_as.rotation.setValueAtTime(0, angle2);
            ControlLay_as.rotation.removeKey(1);
        }
        parent_as[i].rotation.setValueAtTime(0, angle2);
        parent_as[i].rotation.removeKey(1);
        magari.push(Math.abs(angle));
    }

