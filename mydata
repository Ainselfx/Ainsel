    function keybake(keyvalda, efs, pos) {
        if (pos < 2) {
            pos = 0;
        }
        keyadd = efs.addKey(keyvalda[1]);
        if (pos == 0) {
            efs.setValueAtKey(keyadd, keyvalda[2]);
        }
        if (pos == 2) {
            var keypos = [];
            keypos.push(keyvalda[2]);
            keypos.push(keyvalda[3]);
            efs.setValueAtKey(keyadd, keypos);
            pos = 1;
        }
        if (pos == 3) {
            var keypos = [];
            keypos.push(keyvalda[2]);
            keypos.push(keyvalda[3]);
            keypos.push(keyvalda[4]);
            efs.setValueAtKey(keyadd, keypos);
            pos = 2;
        }
        var keyframeProperties = Array();
        var propertyType = Number(keyvalda[3 + pos]);
        keyframeProperties[keyframeProperties.length] = keyvalda[4 + pos];
        keyframeProperties[keyframeProperties.length] = keyvalda[5 + pos];
        keyframeProperties[keyframeProperties.length] = keyvalda[6 + pos];
        keyframeProperties.keyInInterpolationType = Number(keyvalda[7 + pos]);
        keyframeProperties.keyOutInterpolationType = Number(keyvalda[8 + pos]);
        if (propertyType == PropertyValueType.TwoD_SPATIAL || propertyType == PropertyValueType.ThreeD_SPATIAL) {
            var tin = [Number(keyvalda[15 + pos]), Number(keyvalda[16 + pos]), Number(keyvalda[17 + pos])];
            var tout = [Number(keyvalda[18 + pos]), Number(keyvalda[19 + pos]), Number(keyvalda[20 + pos])];
            keyframeProperties.keyInSpatialTangent = tin;
            keyframeProperties.keyOutSpatialTangent = tout;
            keyframeProperties.keySpatialContinuous = keyvalda[21 + pos];
            keyframeProperties.keySpatialAutoBezier = keyvalda[22 + pos];
            keyframeProperties.keyRoving = keyvalda[23 + pos];
        }
        var easeIn = new KeyframeEase(Number(keyvalda[10 + pos]), Number(keyvalda[9 + pos]));
        var easeOut = new KeyframeEase(Number(keyvalda[12 + pos]), Number(keyvalda[11 + pos]));
        keyframeProperties.keyInTemporalEase = [easeIn];
        keyframeProperties.keyOutTemporalEase = [easeOut];
        keyframeProperties.keyTemporalContinuous = keyvalda[13 + pos];
        keyframeProperties.keyTemporalAutoBezier = keyvalda[14 + pos];
        if (propertyType == PropertyValueType.TwoD_SPATIAL || propertyType == PropertyValueType.ThreeD_SPATIAL) {
            try {
                efs.setSpatialTangentsAtKey(keyadd, tin, tout);
            } catch (e) {}
            try {
                efs.setSpatialContinuousAtKey(keyadd, keyframeProperties.keySpatialContinuous);
            } catch (e) {}
            try {
                efs.setSpatialAutoBezierAtKey(keyadd, keyframeProperties.keySpatialAutoBezier);
            } catch (e) {}
            try {
                efs.setRovingAtKey(keyadd, keyframeProperties.keyRoving);
            } catch (e) {}
        }
        if (propertyType == PropertyValueType.TwoD_SPATIAL || propertyType == PropertyValueType.ThreeD_SPATIAL) {
            try {
                efs.setTemporalEaseAtKey(keyadd, [easeIn], [easeOut]);
            } catch (e) {}
        }
        if (propertyType == PropertyValueType.ThreeD) {
            try {
                efs.setTemporalEaseAtKey(keyadd, [easeIn, easeIn, easeIn], [easeOut, easeOut, easeOut]);
            } catch (e) {}
        }
        if (propertyType == PropertyValueType.TwoD) {
            try {
                efs.setTemporalEaseAtKey(keyadd, [easeIn, easeIn], [easeOut, easeOut]);
            } catch (e) {}
        }
        if (propertyType == PropertyValueType.OneD) {
            try {
                efs.setTemporalEaseAtKey(keyadd, [easeIn], [easeOut]);
            } catch (e) {}
        }
        try {
            efs.setTemporalContinuousAtKey(keyadd, keyframeProperties.keyTemporalContinuous);
        } catch (e) {}
        try {
            efs.setInterpolationTypeAtKey(keyadd, keyframeProperties.keyInInterpolationType, keyframeProperties.keyOutInterpolationType);
        } catch (e) {}
        try {
            efs.setSpatialTangentsAtKey(keyadd, tin, tout);
        } catch (e) {}
    }

