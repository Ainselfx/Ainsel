function posChar() {
    var p = replacePos.split(",");
    for (var i = 0; i < sl.length; i += 1) {
        if (filter(i) == false) {
            continue;
        }
        var oldName = sl[i].name;
        var sepName = oldName.split("");
        var myStr = "";
        if (isReplace == true) {
            for (var j = 0; j < p.length; j += 1) {
                var a = parseInt(p[j]);
                if (a > oldName.length || a == 0) {
                    continue;
                }
                if (a > 0) {
                    a -= 1;
                } else {
                    a = oldName.length + a;
                }
                if (isNaN(a) == false) {
                    sepName.splice(a, 1, newName)
                }
            }
        } else {
            for (var j = 0; j < p.length; j += 1) {
                var a = parseInt(p[j]);
                if (a > oldName.length) {
                    continue;
                }
                if (a == 0) {
                    a = oldName.length - 1;
                    sepName[a] = sepName[a] + newName;
                    continue;
                }
                if (a > 0) {
                    a -= 1;
                } else {
                    a = oldName.length + a;
                }
                if (isNaN(a) == false) {
                    sepName[a] = newName + sepName[a]
                }
            }
        }
        for (var j = 0; j < sepName.length; j += 1) {
            myStr += sepName[j];
        }
        sl[i].name = myStr;
    }
}

