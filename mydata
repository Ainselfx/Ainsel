// 创建曲线视图的函数
function createSplineView(parent, size, siding, controlPoints,POINT_SIZE,STROKE_WIDTH) {
    var splineSize = size;
    var sidingSize = siding;
    
    var splineSizeMin = sidingSize;
    var splineSizeMax = splineSize - sidingSize;
    
    // 设置默认控制点 - 创建状态对象
    var state = {
        p1: [splineSizeMin, splineSizeMax],  // 左下角锚点
        p2: [splineSizeMax, splineSizeMin],  // 右上角锚点
        cp1: [splineSizeMin, splineSizeMin], // 左下控制点
        cp2: [splineSizeMax, splineSizeMax]  // 右上控制点
    };

    // 使用传入的控制点更新状态对象
    if (controlPoints) {
        if (controlPoints.p1) state.p1 = controlPoints.p1.slice();
        if (controlPoints.p2) state.p2 = controlPoints.p2.slice();
        if (controlPoints.cp1) state.cp1 = controlPoints.cp1.slice();
        if (controlPoints.cp2) state.cp2 = controlPoints.cp2.slice();
    }
    
    var spline = parent.add("customview");
    spline.size = [splineSize, splineSize];
    
    // 创建绘图工具
    var BRUSH_TYPE = spline.graphics.PenType.SOLID_COLOR;
    var path_stroke = spline.graphics.newPen(BRUSH_TYPE, STROKE_COLOR, STROKE_WIDTH);
    var path_fill = spline.graphics.newBrush(BRUSH_TYPE, FILL_COLOR);
    var bg_brush = spline.graphics.newBrush(BRUSH_TYPE, BG_COLOR);
    var white_pen = spline.graphics.newPen(BRUSH_TYPE, CURVE_COLOR, STROKE_WIDTH);
    
    spline.onDraw = function () {
        var graphics = this.graphics;
        
        // 绘制背景
        graphics.rectPath(splineSizeMin, splineSizeMin, 
                        splineSizeMax - splineSizeMin, 
                        splineSizeMax - splineSizeMin);
        graphics.fillPath(bg_brush);
        
        // 绘制贝塞尔曲线 - 使用状态对象
        graphics.newPath();
        for (var i = 0; i <= 1; i += 0.04) {
            var point = cubicBezier(i, state.p1, state.cp1, state.cp2, state.p2);
            if (i === 0) {
                graphics.moveTo(point[0], point[1]);
            } else {
                graphics.lineTo(point[0], point[1]);
            }
        }
        graphics.strokePath(white_pen);
        
        // 绘制控制线 - 使用状态对象
        graphics.newPath();
        graphics.moveTo(state.p1[0], state.p1[1]);
        graphics.lineTo(state.cp1[0], state.cp1[1]);
        graphics.strokePath(path_stroke); 
        
        graphics.newPath();
        graphics.moveTo(state.p2[0], state.p2[1]);
        graphics.lineTo(state.cp2[0], state.cp2[1]);
        graphics.strokePath(path_stroke); 
        
        // 绘制控制点 - 使用状态对象
        graphics.ellipsePath(state.cp1[0] - POINT_SIZE/2, state.cp1[1] - POINT_SIZE/2, POINT_SIZE, POINT_SIZE);
        graphics.fillPath(path_fill);  
        
        graphics.ellipsePath(state.cp2[0] - POINT_SIZE/2, state.cp2[1] - POINT_SIZE/2, POINT_SIZE, POINT_SIZE);
        graphics.fillPath(path_fill);

        graphics.drawImage(ScriptUI.newImage(File.decode(ZJIcon)), cursor[0],cursor[1], 20, 20);
    };
    
    // 返回包含spline和状态对象的引用
    return {
        spline: spline,
        state: state  // 返回对象引用，外部修改会影响闭包
    };
}

