    function precom(pname, pname2) {
        var myComp = app.project.activeItem;
        if (myComp instanceof CompItem) {
            var myLayers = myComp.selectedLayers;
            if (myLayers.length > 0) {
                var newInPoint = myLayers[0].inPoint;
                var newOutPoint = myLayers[0].outPoint;
                var newCompName = 'Bake ' + pname;
                var layerName = myLayers[0].index;
                if (layerName.length > 26) {
                    layerName = layerName.substring(0, 26);
                }
                newCompName += layerName;
                var layerIndices = new Array();
                for (var i = 0; i < myLayers.length; i += 1) {
                    layerIndices[layerIndices.length] = myLayers[i].index;
                    if (myLayers[i].inPoint < newInPoint) {
                        newInPoint = myLayers[i].inPoint;
                    }
                    if (myLayers[i].outPoint > newOutPoint) {
                        newOutPoint = myLayers[i].outPoint;
                    }
                }
                for (var i = 0; i < myLayers.length; i += 1) {
                    myLayers[i].startTime = myLayers[i].startTime - newInPoint;
                }
                var newComp = myComp.layers.precompose(layerIndices, newCompName, true);
                var preCompLayer = myComp.selectedLayers[0];
                preCompLayer.inPoint = 0;
                preCompLayer.outPoint = newOutPoint - newInPoint;
                preCompLayer.startTime = newInPoint;
                preCompLayer.comment = 'AutoSway BakeData LayerMode(precompose),' + pname2;
                var SwayMarker = new MarkerValue('AutoSway BakeLayer');
                preCompLayer.property('Marker').setValueAtTime(0, SwayMarker);
                preCompLayer.selected = false;
            }
        }
    }

