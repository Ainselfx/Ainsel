function selectPropertyRecursive(propertyContainer, propertyName) {
    for (var i = 1; i <= propertyContainer.numProperties; i++) {
        var prop = propertyContainer.property(i);
        if (prop.name === propertyName) {
            prop.selected = true;
            return true; // 找到并选中后返回true
        }
        if (prop instanceof PropertyGroup) {
            if (selectPropertyRecursive(prop, propertyName)) {
                return true;
            }
        }
    }
    return false;
}

function selectSameProperties(layers) {
    if (layers.length === 0 || !layers[0].selectedProperties || layers[0].selectedProperties.length === 0) {
        return;
    }
    
    var firstProp = layers[0].selectedProperties[0];
    var propertyName = firstProp.name;
    
    // 如果是属性组，尝试获取其内部选中的属性
    if (firstProp instanceof PropertyGroup && firstProp.numProperties > 0) {
        for (var i = 1; i <= firstProp.numProperties; i++) {
            var subProp = firstProp.property(i);
            if (subProp.selected) {
                propertyName = subProp.name;
                break;
            }
        }
    }
    
    // 在所有图层中选中同名属性
    for (var i = 0; i < layers.length; i++) {
        selectPropertyRecursive(layers[i], propertyName);
    }
}

var comp = app.project.activeItem;
if (comp && comp instanceof CompItem) {
    var selectedLayers = comp.selectedLayers;
    if (selectedLayers.length > 0) {
        selectSameProperties(selectedLayers);
    }
}

// 结束撤销组
app.endUndoGroup();
})()
