frameRateGroup.spacing = 8;

frameRateGroup.add("statictext", undefined, "更改帧率:");
zhenlv = frameRateGroup.add("edittext", undefined, "30");
zhenlv.preferredSize = [60, 25];
zhenlv.helpTip = "输入目标帧率";

// 选项区域
var optionsGroup = mainGroup.add("group");
optionsGroup.orientation = "column";
optionsGroup.alignChildren = ["left", "center"];
optionsGroup.spacing = 6;

cb2 = optionsGroup.add("checkbox", undefined, "不改帧速率");
cb2.helpTip = "勾选后，不改帧速率，只更改时长";

cb1 = optionsGroup.add("checkbox", undefined, "不改子合成");
cb1.helpTip = "勾选后，只更改当前合成，不改子合成";

// 按钮区域
var buttonGroup = dlg.add("group");
buttonGroup.orientation = "row";
buttonGroup.alignChildren = ["center", "center"];
buttonGroup.spacing = 10;

// 应用按钮
gg = buttonGroup.add("button", undefined, "应用设置");
gg.preferredSize = [120, 30];
gg.helpTip = "应用时长和帧率设置到选中的合成";

// 取消按钮
var cancelBtn = buttonGroup.add("button", undefined, "取消");
cancelBtn.preferredSize = [80, 30];

// 状态显示
var statusGroup = dlg.add("group");
statusGroup.orientation = "row";
statusGroup.alignChildren = ["left", "center"];
var statusText = statusGroup.add("statictext", undefined, "请选择合成并设置参数");
statusText.preferredSize = [250, 20];

// 按钮事件
gg.onClick = function() {
    statusText.text = "处理中...";
    
    // 原有的处理逻辑
    var shiChang = parseInt(shichang.text);
    var zhenSuLv = parseInt(zhenlv.text);
    var arr_1 = [];
    var arr_2 = [];
    var arr_4 = [];
    var myComp = app.project.selection;
    var q = myComp.length;
    
    if (q === 0) {
        statusText.text = "错误：请先选择合成";
        return;
    }
    
    for (var w = 0; w < q; w += 1) {
        arr_2.push(myComp[w]);
    }
    
    do {
        var myComp = app.project.selection;
        var u = myComp.length;
        for (var v = 0; v < u; v += 1) {
            var myLayer = myComp[v].layers;
            var m = myLayer.length;
            myComp[v].selected = 0;
            for (var i = 1; i < m + 1; i += 1) {
                if (myLayer[i].source instanceof CompItem) {
                    arr_1.push(myLayer[i].source);
                    myLayer[i].source.selected = 1;
                }
            }
        }
    } while (app.project.selection.length > 0)
    
    var a = arr_2.length;
    for (var d = 0; d < a; d += 1) {
        arr_1.unshift(arr_2[d]);
    }
    arr_1.reverse();
    var z = arr_1.length;
    for (var d = 0; d < z; d += 1) {
        arr_4.push(arr_1[d]);
    }
    var v = arr_1.length;
    var f = arr_4.length;
    for (var y = 0; y < v; y += 1) {
        for (var c = 0; c < f; c += 1) {
            if (((arr_1[y].name == arr_4[c].name) & (arr_1[y].id == arr_4[c].id)) & (y != c)) {
                arr_1.splice(c, 1);
                arr_4.splice(c, 1);
                c--;
                v--;
                f--;
            }
        }
    }
    
    app.beginUndoGroup("Undo 时长和帧率");
    if (cb1.value == 1) {
        var myComp = arr_2;
    } else {
        var myComp = arr_1;
    }
    var n = myComp.length;
    for (var m = 0; m < n; m += 1) {
        shiChang = parseInt(shichang.text);
        if (cb2.value == 1) {
            shiChang = myComp[m].duration + shiChang;
        } else {
            shiChang;
        }
        var arr_3 = [];
        var myLayer = myComp[m].layers;
        var b = myLayer.length;
        if (myComp[m].duration <= shiChang) {
            for (var a = 1; a < b + 1; a += 1) {
                if (myLayer[a].locked) {
                    arr_3.push(myLayer[a].index);
                    myLayer[a].locked = 0;
                }
                var eT = myLayer[a].outPoint + 0.001;
                if (eT >= myComp[m].duration) {
                    myLayer[a].outPoint = shiChang;
                }
            }
            myComp[m].duration = shiChang;
        } else {
            myComp[m].duration = shiChang;
        }
        myComp[m].frameRate = zhenSuLv;
        var j = arr_3.length;
        for (var s = 0; s < j; s += 1) {
            myLayer[arr_3[s]].locked = 1;
        }
    }
    app.endUndoGroup();
    
    statusText.text = "完成！已处理 " + n + " 个合成";
};

// 取消按钮事件
cancelBtn.onClick = function() {
    dlg.close();
};

// 显示面板
dlg.center();
dlg.show();

}
