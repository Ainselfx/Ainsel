    function getPuppetPinda(prop) {
        var coins = [];
        if (prop != null) {
            if (prop.matchName == 'ADBE FreePin3 PosPin Atom') {
                coins.push(prop);
            } else {
                if (prop.numProperties > 0) {
                    var proprietes = [];
                    for (var p = 1; p <= prop.numProperties; p += 1) {
                        proprietes.push(prop.property(p));
                    }
                    for (var pi in proprietes) {
                        var newCoins = getPuppetPinda(proprietes[pi]);
                        if (newCoins.length > 0) {
                            coins = coins.concat(newCoins);
                        }
                    }
                }
            }
        }
        return coins;
    }

