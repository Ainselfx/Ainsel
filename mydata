                var SA1 = tvc[0] - ((tw1 / 2) + tl1);
                var SA2 = tvc[1] - ((th1 / 2) + tt1);
                if (T.transform("ADBE Anchor Point").numKeys == 0) {
                    T.transform("ADBE Anchor Point").setValue([(tw1 / 2) + tl1, (th1 / 2) + tt1]);
                } else {
                    for (var i5 = 1; i5 <= T.transform("ADBE Anchor Point").numKeys; i5 += 1) {
                        var TKV = T.transform("ADBE Anchor Point").keyValue(i5);
                        var TKT = T.transform("ADBE Anchor Point").keyTime(i5);
                        T.transform("ADBE Anchor Point").setValueAtTime(TKT, [TKV[0] - SA1, TKV[1] - SA2]);
                    }
                }
                if (!T.position.dimensionsSeparated) {
                    var tvc2 = T.transform("ADBE Position").valueAtTime(curTime, true);
                    var PSA1 = tvc2[0] - layersP1[i];
                    var PSA2 = tvc2[1] - layersP2[i];
                    if (layers[i].transform("ADBE Position").numKeys == 0) {
