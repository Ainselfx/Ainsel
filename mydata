        function keyframecopy(smoto, ef, ename, pos) {
            var Swaykeys = [];
            if (pos < 2) {
                pos = 0;
            }
            if (ef.numKeys > 0) {
                for (var j = 1; j < ef.numKeys + 1; j += 1) {
                    Swaykeys.push(ename);
                    Swaykeys.push(ef.keyTime(j));
                    Swaykeys.push(ef.keyValue(j));
                    var propertyType = ef.propertyValueType;
                    Swaykeys.push(propertyType);
                    Swaykeys.push(ef.isInterpolationTypeValid(KeyframeInterpolationType.LINEAR));
                    Swaykeys.push(ef.isInterpolationTypeValid(KeyframeInterpolationType.BEZIER));
                    Swaykeys.push(ef.isInterpolationTypeValid(KeyframeInterpolationType.HOLD));
                    Swaykeys.push(ef.keyInInterpolationType(j));
                    Swaykeys.push(ef.keyOutInterpolationType(j));
                    Swaykeys.push(objectValues(ef.keyInTemporalEase(j)));
                    Swaykeys.push(objectValues(ef.keyOutTemporalEase(j)));
                    Swaykeys.push(ef.keyTemporalContinuous(j));
                    Swaykeys.push(ef.keyTemporalAutoBezier(j));
                    if (propertyType == PropertyValueType.TwoD_SPATIAL || propertyType == PropertyValueType.ThreeD_SPATIAL) {
                        Swaykeys.push(ef.keyInSpatialTangent(j));
                        Swaykeys.push(ef.keyOutSpatialTangent(j));
                        Swaykeys.push(ef.keySpatialContinuous(j));
                        Swaykeys.push(ef.keySpatialAutoBezier(j));
                        Swaykeys.push(ef.keyRoving(j));
                    }
                    Swaykeys.push(pos);

                    function objectValues(obj) {
                        var list = [];
                        if (typeof obj === 'undefined' || !obj) {
                            return list;
                        }
                        for (var key in obj) {
                            if (obj.hasOwnProperty(key)) {
                                var k = obj[key];
                                if (k != null) {
                                    if (typeof k == 'object') {
                                        list.push(objectValues(k));
                                    } else {
                                        list.push(k.toString());
                                    }
                                }
                            }
                        }
                        return list.join(', ');
                    }
                    smoto.comment += Swaykeys.toString() + BR;
                    Swaykeys = [];
                }
            } else {
                return;
            }
        }
        if (laybool != 8) {
