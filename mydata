    function DuplicateStrat(dx, ax, ay, az, px, py, pz, sx, sy, sz, rx, ry, rz, ox, selectobj, tree) {
        var narabi = [];
        var oa = selectobj.property('ADBE Transform Group').property('ADBE Anchor Point').value;
        var op = selectobj.property('ADBE Transform Group').property('ADBE Position').value;
        if (tree || selectobj instanceof CameraLayer) {
            var orx = selectobj.property('ADBE Transform Group').property('ADBE Rotate X').value;
            var ory = selectobj.property('ADBE Transform Group').property('ADBE Rotate Y').value;
        }
        var orz = selectobj.property('ADBE Transform Group').property('ADBE Rotate Z').value;
        if (selectobj instanceof CameraLayer == false) {
            var os = selectobj.property('ADBE Transform Group').property('ADBE Scale').value;
            var oo = selectobj.property('ADBE Transform Group').property('ADBE Opacity').value;
        }
        var aax = ax;
        var aay = ay;
        var aaz = az;
        var ppx = px;
        var ppy = py;
        var ppz = pz;
        var ssx = sx;
        var ssy = sy;
        var ssz = sz;
        if (tree || selectobj instanceof CameraLayer) {
            var rrx = rx;
            var rry = ry;
        }
        var rrz = rz;
        var oox = ox;
        for (var i = 0; i < dx; i += 1) {
            var obj = selectobj.duplicate();
            nvalue = [];
            oo += ox;
            if (oo > 100) {
                oo = 100;
            }
            if (oo < 0) {
                oo = 0;
            }
            nvalue = [oa[0] + ax, oa[1] + ay, oa[2] + az];
            setValueAtSmart(ax, ay, az, nvalue, obj, 'ADBE Anchor Point');
            nvalue = [op[0] + px, op[1] + py, op[2] + pz];
            setValueAtSmart(px, py, pz, nvalue, obj, 'ADBE Position');
            app.project.activeItem.time = app.project.activeItem.time;
            if (tree || selectobj instanceof CameraLayer) {
                nvalue = ory + ry;
                setValueAtSmart2(ry, nvalue, obj, 'ADBE Rotate X');
                nvalue = orx + rx;
                setValueAtSmart2(rx, nvalue, obj, 'ADBE Rotate Y');
            }
            nvalue = orz + rz;
            setValueAtSmart2(rz, nvalue, obj, 'ADBE Rotate Z');
            if (selectobj instanceof CameraLayer == false) {
                nvalue = [os[0] + sx, os[1] + sy, os[2] + sz];
                setValueAtSmart(sx, sy, sz, nvalue, obj, 'ADBE Scale');
            }
            if (selectobj instanceof CameraLayer == false) {
                nvalue = oo;
                setValueAtSmart3(oo, oox, nvalue, obj, 'ADBE Opacity');
            }
            ax += aax;
            ay += aay;
            az += aaz;
            px += ppx;
            py += ppy;
            pz += ppz;
            sx += ssx;
            sy += ssy;
            sz += ssz;
            oox += ox;
            if (tree || selectobj instanceof CameraLayer) {
                rx += rrx;
                ry += rry;
            }
            rz += rrz;
            narabi.unshift(obj);
        }
        for (var i = 0; i < narabi.length; i += 1) {
            narabi[i].moveBefore(selectobj);
        }
    }

    function setValueAtSmart(x1, y2, z3, newValue, objj, propa) {
        var key = objj.property('ADBE Transform Group').property(propa).numKeys;
        if (key == 0) {
            objj.property('ADBE Transform Group').property(propa).setValue(newValue);
        }
        if (key >= 1) {
            for (var i = 1; i < key + 1; i += 1) {
                var val = objj.property('ADBE Transform Group').property(propa).keyValue(i);
                var valda = [val[0] + x1, val[1] + y2, val[2] + z3];
                objj.property('ADBE Transform Group').property(propa).setValueAtKey(i, valda);
            }
        }
    }

    function setValueAtSmart2(x1, newValue, objj, propa) {
