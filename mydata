    app.beginUndoGroup("图层上下左右排序");
    
    // 获取当前合成
    var comp = app.project.activeItem;
    if (!comp || !(comp instanceof CompItem)) {
        alert("请先打开一个合成");
        return;
    }
    
    // 获取选中的图层
    var selectedLayers = comp.selectedLayers;
    if (selectedLayers.length === 0) {
        alert("请先选择要排序的图层");
        return;
    }
    
    // 将选中的图层转换为数组
    var sylayers = [];
    for (var i = 0; i < selectedLayers.length; i++) {
        sylayers.push(selectedLayers[i]);
    }
    
    // 根据图层位置从左到右，从上到下进行排序
    sylayers.sort(function(a, b) {
        // 获取Y位置（垂直方向）
        var aY = a.property("Position").value[1];
        var bY = b.property("Position").value[1];
        
        // 如果Y位置相同（在同一行），则按X位置排序
        if (Math.abs(aY - bY) < 1) { // 使用容差而不是严格相等
            return a.property("Position").value[0] - b.property("Position").value[0];
        } else {
            return aY - bY;
        }
    });
    
    // 重新设置图层顺序（从底部开始移动，确保顺序正确）
    for (var i = sylayers.length - 1; i >= 0; i--) {
        sylayers[i].moveToBeginning();
    }
    
    // 结束撤销组
    app.endUndoGroup();
}
