    function random_num(num) {
        var random = new Array();
        for (var i = 1; i < num; i += 1) {
            random[i] = Math.floor(Math.random() * num + 1);
        }
        random[0] = Math.floor(Math.random() * num + 1);
        for (var i = 1; i < num; i += 1) {
            j = 0;
            while (j < i) {
                while (random[i] == random[j]) {
                    random[i] = Math.floor(Math.random() * num + 1);
                    j = 0;
                }
                j++;
            }
        }
        return random;
    }

