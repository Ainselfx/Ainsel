    //遍历文件夹分类列表
     function type_sort(){
    // 获取文件夹中所有文件
    var files = new Folder(Preset_folder_path).getFiles();
    if (!files) return;
    if (files.length > 25) return;
    // 存储所有分类文件夹名称的数组
    var filteredFiles = [];
    // 遍历所有文件
    for (var i = 0; i < files.length; i++) {
            // 检查文件名是否包含关键字
        if (files[i] instanceof Folder && files[i].name === 'image') {
            continue//跳出此次循环
            }
            filteredFiles.push(File.decode(files[i].name))
    }
    var referenceOrder = ["常用","脚本","未分类","文字","扫光","粒子","氛围","故障风","科技风","贴图","VFX","单帧闪","滤镜","抖动","过渡","形状","背景"];
    // 1. 创建哈希映射给每个数值标记优化循环次数（兼容 ES3）
    var orderMap = {};
    for (var i = 0; i < referenceOrder.length; i++) {
        orderMap[referenceOrder[i]] = i;
    }

    // 2. 排序逻辑（兼容 ES3）
    filteredFiles.sort(function(a, b) {
        var indexA = orderMap.hasOwnProperty(a) ? orderMap[a] : Infinity;
        var indexB = orderMap.hasOwnProperty(b) ? orderMap[b] : Infinity;
        return indexA - indexB;
    });
        // 将排序后的数组转为JSON字符串
            return JSON.stringify(filteredFiles);
                     }






    //遍历ffx图标返回图标路径和图标对应下标
    function icon_find(keywords) {
        //文件夹内所有的图片路径数据
        var icon_files = new Folder(Preset_folder_path + "/image").getFiles();
        var filteredFiles =[];//图标path数据
        var filteredFiles_index =[];//图标排序数据
        for (var j = 0; j < keywords.length; j++) {
            var keyword = keywords[j];
            for (var i = 0; i < icon_files.length; i++) {
                var file = icon_files[i];
                if (file.name.match(/\.(png||jpg)$/i)) {
                    if (File.decode(file.name).indexOf(keyword) !== -1) {
                        filteredFiles.push(File.decode(file));
                        filteredFiles_index.push(j)
                         // 使用 splice() 方法删除指定下标的元素
                          icon_files.splice([i], 1);
                         break;
                    }
                }
            }
        }
        return [filteredFiles,filteredFiles_index]
    }


    //ffx文件查找
    function ffx_find(keyword, path, resultArray) {
        // var resultArray = [];

        // 安全初始化结果数组（严格验证数组类型）
        // resultArray = Array.isArray(resultArray) ? resultArray : [];
            resultArray = (typeof resultArray !== 'undefined' && resultArray !== null && resultArray instanceof Array) ? resultArray : [];
        // 智能路径处理（支持Folder对象/路径字符串）

        var baseFolder;
        if (path instanceof Folder) {baseFolder = path; } else { baseFolder = path ? new Folder(path) : new Folder(Preset_folder_path);}

        // 获取文件列表时添加错误处理
        var files;
        try {
            files = baseFolder.getFiles();
        } catch (e) {
            alert("无法访问目录: " + baseFolder.fsName);
            return resultArray;
        }

        // 优化遍历逻辑（兼容ES3）
        for (var i = 0; i < files.length; i++) {
            var item = files[i];

            // 处理文件夹（优化名称检查）
            if (item instanceof Folder) {
                // 排除所有image目录（大小写不敏感）
                if (item.name.toLowerCase() !== 'image') {
                    ffx_find(keyword, item, resultArray); // 直接传递Folder对象
                }
                continue;
            }

            // 文件处理流程
            if (isValidPresetFile(item, keyword)) {
                resultArray.push(item);
            }
        }

                return resultArray;
    }


// 独立验证函数（提高可维护性）
function isValidPresetFile(file, keyword) {
    // 严格类型检查
    if (!(file instanceof File)) return false;

    // 2. 定义正则表达式（在使用前）
    var PRESET_EXT_REGEX = /\.(jsx|jsxbin|ffx)$/i;

    // 3. 使用正则表达式检查扩展名
    if (!PRESET_EXT_REGEX.test(file.name)) {
        return false;
    }

    // 关键词匹配（空关键词匹配所有文件）
    return keyword === "" || File.decode(file.name).indexOf(keyword) !== -1;
}


    //ffx文件名查找
    function ffx_name_find(Preset_folder_path) {
        var ffxFiles = []; // 存储结果
        function recursiveSearch(folderPath) {
            // if(new Folder(folderPath).fsName.indexOf("脚本") > 0){
            //     var items = new Folder(folderPath).getFiles(/\.(jsx||jsxbin)$/i);
            // } else {
            //     var items = new Folder(folderPath).getFiles();
            // }
        var items = new Folder(folderPath).getFiles();
        if (items.length <1 ) return;
            for (var i = 0; i < items.length; i++) {
                var item = items[i];
                var fileName = File.decode(item.name);
                // 处理文件夹
                if (item instanceof Folder && fileName !== 'image') {
                        recursiveSearch(item);
                } else {
                             if (fileName.match(/\.(jsx||jsxbin)$/i)) {
                                ffxFiles.push(fileName.replace(/\.(jsx||jsxbin)$/i, ""));
                                } else 
                             if (fileName.match(/\.(ffx)$/i)) {
                                ffxFiles.push(fileName.replace(/\.(ffx)$/i, ""));                                
                                }
                    }
                }
            }
        recursiveSearch(Preset_folder_path);
        return ffxFiles;
    }

        
