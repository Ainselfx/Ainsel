function text_cut() {
var longText = 0;

var text = textEdit.text.replace(/[!！]/g, "！_").replace(/[?？]/g, "？_");
if (checkbox1.value) {
    text = text.replace(/\（[^\）]*\）/g, "");
}
if (checkbox2.value) {
    text = text.replace(/[\s]/g, "");
}
text = text.split(/[,.，。;:；：_]/);

for (i = 0, j = false; i < text.length; i++) {
    if (/“/.test(text[i])) {
        text[i] = text[i].replace("“", "");
        j = true;
    }
    if (/”/.test(text[i])) {
        text[i] = text[i].replace("”", "");
        j = false;
    }
    if (j) {
        text[i] = "“" + text[i] + "”";
    }
}
for (i = 0; i < text.length; i++) {
    if (text[i].length > 20) {
        longText += 1;
    }
}
if (checkbox2.value) {
    text = text.join("\n");
} else {
    text = text.join("");
}

textEdit.text = text;
if (longText != 0) {
    alert("有" + longText + "个超长段，请分割");
}
}

