            inTangents: path.inTangents,
            outTangents: path.outTangents
        };
    }

    function getBoundingBox(vertices) {
        var minX = vertices[0][0];
        var maxX = vertices[0][0];
        var minY = vertices[0][1];
        var maxY = vertices[0][1];
        for (var i = 1; i < vertices.length; i += 1) {
            if (vertices[i][0] < minX) {
                minX = vertices[i][0]
            }
            if (vertices[i][0] > maxX) {
                maxX = vertices[i][0]
            }
            if (vertices[i][1] < minY) {
                minY = vertices[i][1]
            }
            if (vertices[i][1] > maxY) {
                maxY = vertices[i][1]
            }
        }
        return {
            left: minX,
            right: maxX,
            top: minY,
            bottom: maxY,
            width: maxX - minX,
            height: maxY - minY
        };
    }

    function isPointInPolygon(point, vertices) {
        var x = point[0];
        var y = point[1];
        var inside = false;
for (var i = 0, j = vertices.length - 1; i < vertices.length; j = i++) {
            var xi = vertices[i][0];
            var yi = vertices[i][1];
            var xj = vertices[j][0];
            var yj = vertices[j][1];
            var intersect = (yi > y) != (yj > y) && x < ((((xj - xi) * (y - yi)) / ((yj - yi) + 1E-05)) + xi);
            if (intersect) {
                inside = !inside
            }
        }
        return inside;
    }

