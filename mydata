            function findClickedElement(clickX, clickY, tolerance) {
                var closestElement = null;
                var minDistance = Infinity;
                for (var part in BPCT) {
                    var position = BPCT[part];
                    var distance = Math.sqrt(Math.pow(clickX - position[0], 2) + Math.pow(clickY - position[1], 2));
                    // 记录最近的元素
                    if (distance < minDistance) {
                        minDistance = distance;
                        closestElement = part;
                    }
                }
                // 只有在容差范围内才返回结果
                if (closestElement && minDistance <= tolerance) {
                    return closestElement;
                }    
                return null;
            }


