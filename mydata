        // 图层空间转合成空间（完整变换处理）
        function layerToCompPositionSimple(layer, layerPosition) {
            if (!layer) return layerPosition;
            
            // 获取图层的变换属性
            var transform = layer.transform;
            var position = transform.position.value;
            var anchorPoint = transform.anchorPoint.value;
            var scale = transform.scale.value;
                    try {
            var rotation = transform.rotation.value;
                    } catch (error) {
            var rotation = transform.zRotation.value;
                    }
            // 将图层坐标转换为相对于锚点的坐标
            var relativeX = layerPosition[0] - anchorPoint[0];
            var relativeY = layerPosition[1] - anchorPoint[1];
            
            // 应用缩放
            var scaledX = relativeX * (scale[0] / 100);
            var scaledY = relativeY * (scale[1] / 100);
            
            // 应用旋转（转换为弧度）
            var angle = rotation * Math.PI / 180;
            var rotatedX = scaledX * Math.cos(angle) - scaledY * Math.sin(angle);
            var rotatedY = scaledX * Math.sin(angle) + scaledY * Math.cos(angle);
            
            // 转换回合成空间坐标
            var compX = rotatedX + position[0];
            var compY = rotatedY + position[1];
            var compZ = position[2];

            return [compX, compY];
