function fctConstantSpeed() {
    //脚本通过将选中的两个关键帧速度插值转换为线性得到最高点速度值，将两个关键帧的所有速度值调整到最高点速度值
    //第一个关键帧的入点改回初始值，出点修改为33.33333 & 第二个关键帧的入点修改改为33.33333，出点改回初始值，最后将关键帧插值转换回为贝塞尔。
    app.beginUndoGroup("Constant speed");
    var r = app.project.activeItem;
    var n = r.selectedLayers[0];
    n.name;
    var d = fctSelectedKeysOnLayer();

    var h = d[1];
    if (h.length === 0) {
        return alert("Please select some keyframes.");
    }
    if (h.length === 1) {
        if (h[0].selectedKeys.length != 2) {
            return alert("Please select 2 keyframes.");
        }
    } else {
        if (h.length > 1) {
            for (var g = 0; g < h.length; g++) {
                var t = h[g];
                if (t.selectedKeys.length != 2) {
                    return alert("Please select 2 keyframes on each property.");
                }
            }
        }
    }

    for (var e = 0; e < h.length; e++) {
        var a = h[e];
        var s = {};
        var q = {};
        s.index = a.selectedKeys[0];
        q.index = a.selectedKeys[1];
        s.keyInInfluenceX = clamp(a.keyInTemporalEase(s.index)[0].influence, 0.1, 100);

        q.keyOutInfluenceX = clamp(a.keyOutTemporalEase(q.index)[0].influence, 0.1, 100);
        

        if (a.propertyValueType === PropertyValueType.TwoD || a.propertyValueType === PropertyValueType.ThreeD) {
            s.keyInInfluenceY = clamp(a.keyInTemporalEase(s.index)[1].influence, 0.1, 100);
            q.keyOutInfluenceY = clamp(a.keyOutTemporalEase(q.index)[1].influence, 0.1, 100);
        }
        if (a.propertyValueType === PropertyValueType.ThreeD) {
            s.keyInInfluenceZ = clamp(a.keyInTemporalEase(s.index)[2].influence, 0.1, 100);
            q.keyOutInfluenceZ = clamp(a.keyOutTemporalEase(q.index)[2].influence, 0.1, 100);
        }
        var c = 33.333333;

        if (a.keyInInterpolationType(s.index) === 6612) {
            s.keyInInfluenceX = s.keyInInfluenceY = s.keyInInfluenceZ = c;
        }
        s.keyOutInfluenceX = s.keyOutInfluenceY = s.keyOutInfluenceZ = c;
        q.keyInInfluenceX = q.keyInInfluenceY = q.keyInInfluenceZ = c;
        if (a.keyOutInterpolationType(q.index) === 6612) {
            q.keyOutInfluenceX = q.keyOutInfluenceY = q.keyOutInfluenceZ = c;
        }

        a.setInterpolationTypeAtKey(s.index, 6612, 6612);
        a.setInterpolationTypeAtKey(q.index, 6612, 6612);

        var m = a.keyOutTemporalEase(s.index)[0].speed;
        s.keyInTemporalEaseX = new KeyframeEase(m, s.keyInInfluenceX);
        s.keyOutTemporalEaseX = new KeyframeEase(m, s.keyOutInfluenceX);
        q.keyInTemporalEaseX = new KeyframeEase(m, q.keyInInfluenceX);
        q.keyOutTemporalEaseX = new KeyframeEase(m, q.keyOutInfluenceX);
        if (a.propertyValueType === PropertyValueType.TwoD || a.propertyValueType === PropertyValueType.ThreeD) {
            var k = a.keyOutTemporalEase(s.index)[1].speed;
            s.keyInTemporalEaseY = new KeyframeEase(k, s.keyInInfluenceY);
            s.keyOutTemporalEaseY = new KeyframeEase(k, s.keyOutInfluenceY);
            q.keyInTemporalEaseY = new KeyframeEase(k, q.keyInInfluenceY);
            q.keyOutTemporalEaseY = new KeyframeEase(k, q.keyOutInfluenceY);
        }

        if (a.propertyValueType === PropertyValueType.ThreeD) {
            var f = a.keyOutTemporalEase(s.index)[2].speed;
            s.keyInTemporalEaseZ = new KeyframeEase(f, s.keyInInfluenceZ);
            s.keyOutTemporalEaseZ = new KeyframeEase(f, s.keyOutInfluenceZ);
            q.keyInTemporalEaseZ = new KeyframeEase(f, q.keyInInfluenceZ);
            q.keyOutTemporalEaseZ = new KeyframeEase(f, q.keyOutInfluenceZ);
        }

        if (a.propertyValueType === PropertyValueType.ThreeD) {
            a.setTemporalEaseAtKey(s.index, [s.keyInTemporalEaseX, s.keyInTemporalEaseY, s.keyInTemporalEaseZ], [s.keyOutTemporalEaseX, s.keyOutTemporalEaseY, s.keyOutTemporalEaseZ]);
            a.setTemporalEaseAtKey(q.index, [q.keyInTemporalEaseX, q.keyInTemporalEaseY, q.keyInTemporalEaseZ], [q.keyOutTemporalEaseX, q.keyOutTemporalEaseY, q.keyOutTemporalEaseZ]);
        } else {
            if (a.propertyValueType === PropertyValueType.TwoD) {
                a.setTemporalEaseAtKey(s.index, [s.keyInTemporalEaseX, s.keyInTemporalEaseY], [s.keyOutTemporalEaseX, s.keyOutTemporalEaseY]);
                a.setTemporalEaseAtKey(q.index, [q.keyInTemporalEaseX, q.keyInTemporalEaseY], [q.keyOutTemporalEaseX, q.keyOutTemporalEaseY]);
            } else {
               a.setTemporalEaseAtKey(s.index, [s.keyInTemporalEaseX], [s.keyOutTemporalEaseX]);
               a.setTemporalEaseAtKey(q.index, [q.keyInTemporalEaseX], [q.keyOutTemporalEaseX]);
            }
        }
        a.setTemporalContinuousAtKey(s.index, true);
        a.setTemporalContinuousAtKey(q.index, true);
    }
    app.endUndoGroup();
}
function fctSelectedKeysOnLayer() {
    var d = app.project.activeItem;
    var h = [];
    var c = [];
    var f = false;
    for (var i = 1; i <= d.numLayers; i++) {
