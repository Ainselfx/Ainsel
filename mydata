        for (var i = 0; i < existingPoints.length; i += 1) {
            var dx = point[0] - existingPoints[i][0];
            var dy = point[1] - existingPoints[i][1];
            var distance = Math.sqrt((dx * dx) + (dy * dy));
            if (distance < minSpacing) {
                return true;
            }
        }
        return false;
    }

    function cubicBezier(p0, p1, p2, p3, t) {
        var mt = 1 - t;
        return [(mt * mt * mt * p0[0]) + (3 * mt * mt * t * p1[0]) + (3 * mt * t * t * p2[0]) + (t * t * t * p3[0]), (mt * mt * mt * p0[1]) + (3 * mt * mt * t * p1[1]) + (3 * mt * t * t * p2[1]) + (t * t * t * p3[1])];
    }

    function samplePathPointsArcLength(vertices, inTangents, outTangents, closed, count, isRandom) {
        var segs = vertices.length;
        var samples = [];
        var totalLen = 0;
        var sampleStep = 0.01;
        for (var i = 0; i < segs; i += 1) {
            var p0 = vertices[i];
            var p1 = [p0[0] + outTangents[i][0], p0[1] + outTangents[i][1]];
            var nextIdx = (i + 1) % segs;
            if (!closed && i === (segs - 1)) {
                break;
            }
            var p3 = vertices[nextIdx];
            var p2 = [p3[0] + inTangents[nextIdx][0], p3[1] + inTangents[nextIdx][1]];
            var prev = p0;
            var accLen = totalLen;
            samples.push({
                pt: p0,
                len: accLen
            });
            for (var t = sampleStep; t <= 1; t += sampleStep) {
                var pt = cubicBezier(p0, p1, p2, p3, t);
                var dx = pt[0] - prev[0];
                var dy = pt[1] - prev[1];
                accLen += Math.sqrt((dx * dx) + (dy * dy));
                samples.push({
                    pt: pt,
                    len: accLen
                });
                prev = pt;
            }
            totalLen = accLen;
        }
        var points = [];
        for (var i = 0; i < count; i += 1) {
            var targetLen = isRandom ? Math.random() * totalLen : (totalLen * i) / count;
            var idx = 0;
            while (idx < (samples.length - 1) && samples[idx + 1].len < targetLen) {
                idx++
            }
            var s0 = samples[idx];
            var s1 = samples[Math.min(idx + 1, samples.length - 1)];
            var l0 = s0.len;
            var l1 = s1.len;
            var t = (l1 - l0) > 0 ? (targetLen - l0) / (l1 - l0) : 0;
            var x = s0.pt[0] + ((s1.pt[0] - s0.pt[0]) * t);
            var y = s0.pt[1] + ((s1.pt[1] - s0.pt[1]) * t);
            points.push([x, y]);
        }
        return points;
    }

    function samplePointsInPolygon(vertices, count, minSpacing) {
        var bbox = getBoundingBox(vertices);
        var points = [];
        var maxAttempts = count * 30;
        var attempts = 0;
        while (points.length < count && attempts < maxAttempts) {
            var x = bbox.left + (Math.random() * bbox.width);
            var y = bbox.top + (Math.random() * bbox.height);
            if (isPointInPolygon([x, y], vertices) && !isTooClose([x, y], points, minSpacing)) {
                points.push([x, y]);
            }
            attempts++;
        }
        return points;
    }

    function main() {
        app.beginUndoGroup('hcqyfz');
        try {
            var maskLayerIdx = maskLayerDropdown.selection ? maskLayerDropdown.selection.index : 0;
            var compLayerIdx = compLayerDropdown.selection ? compLayerDropdown.selection.index : 0;
            var maskLayer = activeComp.layer(maskLayerIdx + 1);
            var compLayer = activeComp.layer(compLayerIdx + 1);
            if (!maskLayer || !compLayer) {
                alert("请确保选择了蒙版图层和要复制的合成图层！");
                return;
            }
            var selectedMaskIdxs = [];
            for (var i = 0; i < maskListBox.items.length; i += 1) {
                if (maskListBox.items[i].selected) {
                    selectedMaskIdxs.push(i)
                }
            }
            if (selectedMaskIdxs.length === 0) {
                alert("请至少选择一个蒙版！");
                return;
            }
            var count = parseInt(countInput.text) || 10;
            var minSpacing = parseFloat(minSpacingInput.text) || 0;
            var maxRotation = parseFloat(rotationInput.text) || 0;
            var maxScale = parseFloat(scaleInput.text) || 0;
            var isRandom = distributionDropdown.selection && distributionDropdown.selection.index === 1;
            var areaMode = areaDropdown.selection ? areaDropdown.selection.index : 0;
            var position = maskLayer.property("Position").value;
            var anchor = maskLayer.property("Anchor Point").value;
            var perMask = Math.floor(count / selectedMaskIdxs.length);
            var remain = count - (perMask * selectedMaskIdxs.length);
            var placedPoints = [];
            for (var m = 0; m < selectedMaskIdxs.length; m += 1) {
                var maskIdx = selectedMaskIdxs[m];
                var pathInfo = getMaskPathInfo(maskLayer, maskIdx);
                if (!pathInfo) {
                    continue;
                }
                var vertices = pathInfo.vertices;
                var inTangents = pathInfo.inTangents;
                var outTangents = pathInfo.outTangents;
                var closed = maskLayer.Masks.property(maskIdx + 1).property("Mask Path").value.closed;
                var thisCount = perMask + (m === (selectedMaskIdxs.length - 1) ? remain : 0);
                var pathPoints = [];
                if (areaMode === 0) {
                    pathPoints = samplePathPointsArcLength(vertices, inTangents, outTangents, closed, thisCount, isRandom);
                } else {
                    pathPoints = samplePointsInPolygon(vertices, thisCount, minSpacing);
                }
                for (var i = 0; i < pathPoints.length; i += 1) {
                    var pt = pathPoints[i];
                    var x = (pt[0] + position[0]) - anchor[0];
                    var y = (pt[1] + position[1]) - anchor[1];
