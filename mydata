    // ========== 功能函数 ==========
    function applyMultiplane() {
        var comp = app.project.activeItem;
        if (!comp || !(comp instanceof CompItem)) {
            alert("请先选择一个合成");
            return;
        }
        
        var compCenter = [comp.width / 2, comp.height / 2];
        var layers = comp.layers;
        var selectedLayers = comp.selectedLayers;
        var useSelected = selectedLayers.length > 0 && !(selectedLayers.length === 1 && selectedLayers[0].matchName === "ADBE Camera Layer");
        
        app.beginUndoGroup("应用多平面");
        
        // 获取或创建相机
        var camera = setupCamera(comp, compCenter);
        
        // 处理图层
        var targetLayers = [];
        if (useSelected) {
            for (var i = 0; i < selectedLayers.length; i++) {
                targetLayers.push(selectedLayers[i]);
            }
        } else {
            for (var j = 1; j <= layers.length; j++) {
                var layer = layers[j];
                if (layer !== camera) {
                    targetLayers.push(layer);
                }
            }
        }
        
        var processedLayers = [];
        
        for (var k = 0; k < targetLayers.length; k++) {
            var currentLayer = targetLayers[k];
            if (!currentLayer.hasVideo || currentLayer.matchName === "ADBE Camera Layer" || 
                currentLayer.matchName === "ADBE Light Layer" || currentLayer.locked) {
                continue;
            }
            
            // 确保是3D图层
            if (!currentLayer.threeDLayer) currentLayer.threeDLayer = true;
            if (currentLayer.canSetCollapseTransformation && !(currentLayer.source instanceof CompItem)) {
                currentLayer.collapseTransformation = true;
            }
            
            // 处理图层
            var processed = processLayer(currentLayer, comp, compCenter);
            if (processed) {
                processedLayers.push(processed);
            }
        }
        
        // 自动排列Z轴
        if (config.autoArrange && processedLayers.length > 0) {
            arrangeLayersOnZAxis(processedLayers);
        }
        
        app.endUndoGroup();
    }
    
    function setupCamera(comp, compCenter) {
        var focalLength = FOCAL_LENGTH_DATA[LENS_PRESETS[config.lensIndex]].aperture;
        var filmWidth = comp.width / comp.pixelAspect;
        var cameraDistance = Math.round((filmWidth / 2) / Math.tan((focalLength * Math.PI / 180) / 2) * 10000) / 10000;
        
        // 查找现有相机
        for (var i = 1; i <= comp.layers.length; i++) {
            var layer = comp.layers[i];
            if (layer.matchName === "ADBE Camera Layer" && layer.active) {
                var pos = layer.property("ADBE Transform Group").property("ADBE Position").value;
                var zoom = layer.property("ADBE Camera Options Group").property("ADBE Camera Zoom").value;
                
                if (compCenter[0] === pos[0] && compCenter[1] === pos[1] && 
                    Math.floor(cameraDistance) === Math.floor(-pos[2]) && 
                    Math.floor(cameraDistance) === Math.floor(zoom)) {
                    return layer;
                }
            }
        }
        
        // 创建新相机
        var camera = comp.layers.addCamera("Camera 1", compCenter);
        var cameraOptions = camera.property("ADBE Camera Options Group");
        try {
        cameraOptions.property("ADBE Camera Zoom").setValue(cameraDistance);
        cameraOptions.property("ADBE Camera Focus Distance").setValue(cameraDistance);
        cameraOptions.property("ADBE Camera Aperture").setValue(FOCAL_LENGTH_DATA[LENS_PRESETS[config.lensIndex]].fStop);
        var posProp = camera.property("ADBE Transform Group").property("ADBE Position");
        posProp.setValue([compCenter[0], compCenter[1], -cameraDistance]);
        } catch (error) {}
        
        if (config.nodeIndex === 0) {
            camera.autoOrient = AutoOrientType.NO_AUTO_ORIENT;
        }
        
        return camera;
    }
    
    function processLayer(layer, comp, compCenter) {
        var transform = layer.property("ADBE Transform Group");
        var focalLength = FOCAL_LENGTH_DATA[LENS_PRESETS[config.lensIndex]].aperture;
        var filmWidth = comp.width / comp.pixelAspect;
        var cameraDistance = Math.round((filmWidth / 2) / Math.tan((focalLength * Math.PI / 180) / 2) * 10000) / 10000;
        
        // 检查是否已有表达式
        if (transform.property("ADBE Scale").expression.indexOf("camZoom") === 0) {
            return layer;
        }
        
        // 检查是否需要空控制器
        if (config.useNullControllers || hasAnimation(layer) || transform.property("ADBE Position").value[2] !== 0) {
            return createNullController(layer, comp, compCenter, cameraDistance);
        }
        
        // 直接处理图层
        return setupLayerDirect(layer, transform, compCenter, cameraDistance);
    }
    
    function hasAnimation(layer) {
        var props = ["ADBE Position", "ADBE Anchor Point", "ADBE Rotate Z", "ADBE Scale"];
        var transform = layer.property("ADBE Transform Group");
        
        for (var i = 0; i < props.length; i++) {
            var p = transform.property(props[i]);
            if (p.numKeys > 0 || p.dimensionsSeparated || p.expression !== "") {
                return true;
            }
        }
        
        var scale = transform.property("ADBE Scale").value;
        if (Math.abs(scale[0] - 100) > 0.1) {
            return true;
        }
        
        return false;
    }
    
    function createNullController(layer, comp, compCenter, cameraDistance) {
        var nullLayer = comp.layers.addNull();
        nullLayer.threeDLayer = true;
        nullLayer.moveBefore(layer);
        
        var nullTransform = nullLayer.property("ADBE Transform Group");
        nullTransform.property("ADBE Scale").expression = 
            "camZoom = " + cameraDistance + "; distance = position[2] + camZoom; scale * (distance / camZoom);";
        
        var layerPos = layer.property("ADBE Transform Group").property("ADBE Position").value;
        nullTransform.property("ADBE Position").setValue([compCenter[0], compCenter[1], layerPos[2]]);
        
        layer.parent = nullLayer;
        nullLayer.property("ADBE Marker").setValueAtTime(0.5, new MarkerValue(MARKER_CONTROL));
        
        return nullLayer;
    }
    
    function setupLayerDirect(layer, transform, compCenter, cameraDistance) {
        var pos = transform.property("ADBE Position").value;
        var anchor = transform.property("ADBE Anchor Point").value;
        var scale = transform.property("ADBE Scale").value;
        
        var offset = [
            (pos[0] - compCenter[0]) * (100 / scale[0]),
            (pos[1] - compCenter[1]) * (100 / scale[1]),
            0
        ];
        
        setPropertyValue(transform.property("ADBE Position"), [compCenter[0], compCenter[1], pos[2]]);
        setPropertyValue(transform.property("ADBE Anchor Point"), [anchor[0] - offset[0], anchor[1] - offset[1], anchor[2]]);
        
        transform.property("ADBE Scale").expression = 
            "camZoom = " + cameraDistance + "; distance = position[2] + camZoom; scale * (distance / camZoom);";
        
        // 添加标记
        if (!hasMultiplaneMarker(layer)) {
            layer.property("ADBE Marker").setValueAtTime(0.5, new MarkerValue(MARKER_MULTIPLANE));
        }
        
        return layer;
    }
    
    function setPropertyValue(prop, value) {
        if (prop.numKeys === 0) {
            prop.setValue(value);
        } else {
            prop.setValueAtTime(prop.propertyGroup(2).containingComp.time, value);
        }
    }
    
    function hasMultiplaneMarker(layer) {
        var markers = layer.property("ADBE Marker");
        var maxKeys = Math.min(markers.numKeys, 5);
        
        for (var i = 1; i <= maxKeys; i++) {
            var comment = markers.keyValue(i).comment;
            if (comment && comment.indexOf("Multiplane") !== -1) {
                return true;
            }
        }
        return false;
    }
    
    function arrangeLayersOnZAxis(layers) {
        // 按索引排序
        layers.sort(function(a, b) {
            return a.index - b.index;
        });
        
        var front = config.rangeFront;
        var back = config.rangeBack;
        var step = layers.length === 1 ? 0 : (back - front) / (layers.length - 1);
        
        if (config.distributionIndex === 0) { // 均匀分布
            for (var i = 0; i < layers.length; i++) {
                setZPosition(layers[i], front + step * i);
            }
        } else { // 随机分布
            var randomValues = generateRandomValues(layers.length, config.distributionIndex === 1);
            for (var j = 0; j < layers.length; j++) {
                setZPosition(layers[j], front + randomValues[j] * (back - front));
            }
        }
    }
    
    function generateRandomValues(count, sorted) {
        var values = [];
        while (values.length < count) {
            var val = Math.random();
            var exists = false;
            for (var i = 0; i < values.length; i++) {
                if (values[i] === val) {
                    exists = true;
                    break;
                }
            }
            if (!exists) {
                values.push(val);
            }
        }
        
        if (sorted) {
            values.sort(function(a, b) {
                return a - b;
            });
        }
        
        return values;
    }
    
    function setZPosition(layer, z) {
        var pos = layer.property("ADBE Transform Group").property("ADBE Position");
        pos.setValue([pos.value[0], pos.value[1], Math.round(z)]);
    }
    
    function bakeMultiplane() {
        var comp = app.project.activeItem;
        if (!comp || !(comp instanceof CompItem)) {
            alert("请先选择一个合成");
            return;
        }
        
        var selected = comp.selectedLayers;
        var targetLayers = [];
        
        if (selected.length === 0) {
            for (var i = 1; i <= comp.layers.length; i++) {
                targetLayers.push(comp.layers[i]);
            }
        } else {
            for (var j = 0; j < selected.length; j++) {
                targetLayers.push(selected[j]);
            }
        }
        
        app.beginUndoGroup("烘焙多平面");
        
        for (var k = 0; k < targetLayers.length; k++) {
            var layer = targetLayers[k];
            if (!layer.hasVideo || layer.matchName === "ADBE Camera Layer" || 
                layer.matchName === "ADBE Light Layer") {
                continue;
            }
            
            // 处理空控制器
            if (layer.nullLayer && hasMultiplaneMarker(layer)) {
                layer.remove();
                continue;
            }
            
            // 处理有表达式的图层
            if (layer.threeDLayer && layer.property("Scale").expression !== "") {
                bakeLayer(layer, comp);
            }
            
            // 移除标记
            removeMultiplaneMarker(layer);
        }
        
        app.endUndoGroup();
    }
    
    function bakeLayer(layer, comp) {
        var scale = layer.property("Scale").value;
        layer.property("Scale").expression = "";
        setPropertyValue(layer.property("Scale"), scale);
        
        var pos = layer.property("Position");
        var anchor = layer.property("Anchor Point");
        
        var anchorOffset;
        if (layer instanceof TextLayer || layer instanceof ShapeLayer) {
            anchorOffset = anchor.value;
        } else {
            anchorOffset = [
                anchor.value[0] - layer.width / 2,
                anchor.value[1] - layer.height / 2,
                anchor.value[2]
            ];
        }
        
        var offset = [
            anchorOffset[0] * (scale[0] / 100),
            anchorOffset[1] * (scale[1] / 100),
            anchorOffset[2] * (scale[2] / 100)
        ];
        
        setPropertyValue(pos, [
            pos.value[0] - offset[0],
            pos.value[1] - offset[1],
            pos.value[2] - offset[2]
        ]);
        
        if (layer instanceof TextLayer || layer instanceof ShapeLayer) {
            setPropertyValue(anchor, [0, 0, 0]);
        } else {
            setPropertyValue(anchor, [layer.width / 2, layer.height / 2, 0]);
        }
    }
    
    function removeMultiplaneMarker(layer) {
        var markers = layer.property("ADBE Marker");
        for (var i = 1; i <= markers.numKeys; i++) {
            var comment = markers.keyValue(i).comment;
            if (comment && comment.indexOf("Multiplane") !== -1) {
                markers.removeKey(i);
                break;
            }
        }
    }
    
    function showHelp() {
        var win = new Window("palette", SCRIPT_NAME + " 帮助");
        
        // 添加说明文本
        var helpET = win.add("edittext", undefined, HELP_TEXT, { 
            multiline: true,
            scrolling: true,
            readonly: true
        });
        helpET.alignment = ['fill', 'fill'];
        helpET.preferredSize = [480, 500];
        
        // 添加关闭按钮
        var btnGroup = win.add("group");
        btnGroup.alignment = ['center', 'bottom'];
        var closeBtn = btnGroup.add("button", undefined, "关闭");
        closeBtn.onClick = function() {
            win.close();
        };
        
        // 布局并显示
        win.layout.layout(true);
        win.center(); // 居中显示
        win.show();
    }
    
    // ========== 工具函数 ==========
    function loadConfig() {
        config.autoArrange = getSetting("_AutoArrange", true);
        config.distributionIndex = getSetting("_LayerDistribution", 0, true);
        config.rangeFront = getSetting("_FrontRange", DEFAULT_RANGE_FRONT, true);
        config.rangeBack = getSetting("_BackRange", DEFAULT_RANGE_BACK, true);
        config.useNullControllers = getSetting("_NullControllers", false);
        config.nodeIndex = getSetting("_NodeIndex", 0, true);
        config.lensIndex = getSetting("_LensPreset", DEFAULT_LENS_INDEX, true);
        config.checkUpdates = getSetting("_UpdateCheck", false);
    }
    
    function getSetting(key, defaultValue, isNumber) {
        if (isNumber === undefined) isNumber = false;
        
        var fullKey = SCRIPT_NAME + key;
        
        if (!app.settings.haveSetting(SETTINGS_GROUP, fullKey)) {
            return defaultValue;
        }
        
        var val = app.settings.getSetting(SETTINGS_GROUP, fullKey);
        
        if (isNumber) {
            var num = parseInt(val, 10);
            return isNaN(num) ? defaultValue : num;
        }
        
        if (typeof defaultValue === "boolean") {
            return val === "true";
        }
        
        return val;
    }
    
    function saveSetting(key, value) {
        app.settings.saveSetting(SETTINGS_GROUP, SCRIPT_NAME + key, value.toString());
        app.preferences.saveToDisk();
    }
    
    function isNetworkAllowed() {
        return app.preferences.getPrefAsLong("Main Pref Section", "Pref_SCRIPTING_FILE_NETWORK_SECURITY") === 1;
    }
    
    function showNetworkPermissionWarning() {
        var msg = "此脚本需要网络权限。\n请前往\"编辑\" > \"首选项\" > \"常规\"，勾选\"允许脚本写入文件和访问网络\"。";
        alert(msg);
        app.executeCommand(2359);
    }
    
    function openURL(url) {
        if (!isNetworkAllowed()) {
            alert("需要网络权限才能打开链接");
            return;
