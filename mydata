    } else {
        var rot = [ccLayer.xRotation.value, ccLayer.yRotation.value, ccLayer.zRotation.value];
        var orientPoint = rotate3DPointAround3DPoint(tlPoint + addCoord, tlPoint, rot);
        rot = ccLayer.orientation.value;
        return rotate3DPointAround3DPoint(orientPoint, tlPoint, rot);
    }
}

