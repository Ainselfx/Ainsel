        function zeroInPoints(obj) {
            var inPointAry = [];
            var startTimeAry = [];
            var deltaAry = [];
            for (var i = 0; i < obj.numSelected; i += 1) {
                inPointAry[i] = obj.selLayers[i].inPoint;
                startTimeAry[i] = obj.selLayers[i].startTime;
                deltaAry[i] = inPointAry[i] - startTimeAry[i];
            }
            var firstInPoint = inPointAry[0];
            for (var c = 1; c < inPointAry.length; c += 1) {
                var checkInPoint = inPointAry[c];
                if (checkInPoint < firstInPoint) {
                    firstInPoint = checkInPoint;
                }
            }
            if (firstInPoint < 0) {
                firstInPoint = 0;
            }
            for (var s = 0; s < obj.numSelected; s += 1) {
                obj.selLayers[s].startTime = firstInPoint - deltaAry[s];
            }
            obj.deltaAry = deltaAry;
            return obj.deltaAry;
        }

        function centerOUT(menuSelect, compObj, selectObj) {
            for (var d = 0; d < selectObj.numSelected; d += 1) {
                var xLAYR = selectObj.selLayers[d].property("Transform").property("Position").value[0];
                var yLAYR = selectObj.selLayers[d].property("Transform").property("Position").value[1];
                var layerDist = Math.sqrt(Math.pow(compObj.xCNTR - xLAYR, 2) + Math.pow(compObj.yCNTR - yLAYR, 2));
                var layerDelay = Math.ceil((((menuSelect.delayMax * layerDist) / compObj.maxRadialDist) / compObj.fDur) * compObj.fDur) * compObj.fDur;
                selectObj.selLayers[d].startTime = selectObj.selLayers[d].inPoint + (layerDelay - selectObj.deltaAry[d]);
            }
