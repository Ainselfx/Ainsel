                            newLayer.property("Scale").setValue([scale, scale]);
                        }
                        placedPoints.push([x, y]);
                    }
                }
            }
            if (placedPoints.length < count) {
                alert("警告：由于间距限制，只放置了 " + placedPoints.length + " 个副本。");
            } else {
                alert("成功放置了 " + placedPoints.length + " 个副本。");
            }
        } catch (e) {
            alert("执行过程中出错: " + e.toString());
        }
