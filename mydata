function 解预合成() {
function decomposePrecompsAndKeepPSR(){
        app.beginUndoGroup("解预合成保持PSR");
        var comp = app.project.activeItem;
        if (!comp || !(comp instanceof CompItem)) {
            alert("请选择一个合成");
            return;
        }
        // 获取第一个选中的图层
        var currentLayer = comp.selectedLayers[0];
        var precompSource = currentLayer.source;

        //遍历合成内是否有父级是否有动画
        for (var i = 1; i <= precompSource.numLayers; i++) {
            var layer = precompSource.layer(i);
            if (!layer.parent) {
                // 检查PSRTA属性是否有动画（2个或以上关键帧）并获取最早关键帧时间
                var animationInfo = checkIfLayerHasAnimation(layer);
                    if(animationInfo[0]){
                        // 创建空对象
                    var nullLayer = precompSource.layers.addSolid([0,0,0], layer.name + "| Null", layer.width, layer.height, 1, 1);
                        nullLayer.inPoint = layer.inPoint;
                        nullLayer.outPoint = layer.outPoint;
                        nullLayer.enabled = false;//眼睛
                        nullLayer.guideLayer = true;//参考层
                        layer.parent = nullLayer;
                        }
            }
        }
        if (currentLayer.source instanceof CompItem) {decomposePrecompWithPSR(currentLayer, comp);}
        app.endUndoGroup();




                function decomposePrecompWithPSR(precompLayer, comp) {
                    comp.time = precompLayer.inPoint;
                    var precompSource = precompLayer.source;
                    // 检查PSRTA属性是否有动画（2个或以上关键帧）并获取最早关键帧时间
                    var animationInfo = checkIfLayerHasAnimation(precompLayer);

                    // 记录原始PSR属性
                    var originalTransform = {
                        position: precompLayer.property("Position").value,
                        scale: precompLayer.property("Scale").value,
                        rotation: precompLayer.property("Rotation").value,
                        anchorPoint: precompLayer.property("Anchor Point").value,
                        opacity: precompLayer.property("Opacity").value
                    };
                    
                    // 记录时间属性
                    var startTime = precompLayer.startTime;
                    var inPoint = precompLayer.inPoint;
                    var outPoint = precompLayer.outPoint;
                    var layerName = precompLayer.name;

                    // 记录预合成图层的索引
                    var precompIndex = precompLayer.index;
                    
                    // 记录预合成内图层的父级关系
                    var parentHolders = [];
                    for (var i = 1; i <= precompSource.numLayers; i++) {
                        var layer = precompSource.layer(i);
                        parentHolders[i] = layer.parent;  // 保存父级对象
                        if (layer.parent) {
                            layer.parent = null;  // 临时解除父级关系
                        }
                    }
                    
                    // 复制预合成内的所有图层到当前合成（从上往下复制）
                    for (var i = 1; i <= precompSource.numLayers; i++) {
                        var sourceLayer = precompSource.layer(i);
                        sourceLayer.copyToComp(comp);
                    }
                    
                    // 恢复预合成内的父级关系
                    for (var i = 1; i <= precompSource.numLayers; i++) {
                        var layer = precompSource.layer(i);
                        layer.parent = parentHolders[i];  // 恢复父级关系
                    }

                    // 正确获取刚刚复制的所有图层
                    var pastedLayers = [];
                    // 新复制的图层出现在预合成图层的上方，从precompIndex开始
                    for (var j = precompIndex; j < precompIndex + precompSource.numLayers; j++) {
                        pastedLayers.push(comp.layer(j));
                    }

                    // 重新建立复制后图层的父子级关系
                    for (var k = 0; k < pastedLayers.length; k++) {
                        var originalIndex = k + 1;  // 原始索引（从上往下复制，顺序一致）
                        var originalParent = parentHolders[originalIndex];
                        
                        if (originalParent) {
                            // 找到对应的父级图层在复制后的图层中
                            var parentOriginalIndex = originalParent.index;
                            var parentNewIndex = parentOriginalIndex - 1;  // 索引对应
                            
                            if (parentNewIndex >= 0 && parentNewIndex < pastedLayers.length) {
                                pastedLayers[k].parent = pastedLayers[parentNewIndex];
                            }
                        }
                    }


                

                    function copyAnimationToNullLayer(comp, precompLayer, layerName, inPoint, outPoint,startTime) {
                        // alert(animationInfo[1])
                       comp.time = animationInfo[1];
                        // 先选中预合成图层的属性
                        precompLayer.property("Position").selected = true;
                        precompLayer.property("Scale").selected = true;
                        precompLayer.property("Rotation").selected = true;
                        precompLayer.property("Anchor Point").selected = true;
                        precompLayer.property("Opacity").selected = true;
                        // 复制属性
                        try {
                            app.executeCommand(app.findMenuCommandId("Copy"));
                            app.executeCommand(app.findMenuCommandId("复制(C)"));
                        } catch (error) {}
                        
                        // 创建空对象
                        var precompSource = precompLayer.source;
                        var nullLayer = comp.layers.addSolid([0,0,0], layerName + "| Null", precompSource.width, precompSource.height, 1, 1);

                        // 粘贴到空对象
                        try {
                            app.executeCommand(app.findMenuCommandId("Paste"));
                            app.executeCommand(app.findMenuCommandId("粘贴(P)")); 
                        } catch (error) {}
                        nullLayer.startTime = startTime;
                        nullLayer.inPoint = inPoint;
                        nullLayer.outPoint = outPoint;
                        nullLayer.moveBefore(precompLayer);
                        return nullLayer;
                    }

                    // 调用函数
                    var nullLayer = copyAnimationToNullLayer(comp, precompLayer, layerName, inPoint, outPoint,startTime);

                    // 对每个新图层应用原始PSR变换
                    for (var m = 0; m < pastedLayers.length; m++) {
                        var layer = pastedLayers[m];
                        
                        // 只有没有父级的图层才应用完整的变换
                        if (!layer.parent) {
                            applyTransform(layer, originalTransform, precompLayer);
                            if(animationInfo[0]){layer.parent = nullLayer;}
                        } else {
                            // 有父级的图层只需要应用基础透明度
                            applyBasicTransform(layer, originalTransform, precompLayer);
                        }

                        //设置时间属性
                        // layer.startTime = startTime;
                        if(layer.inPoint< precompLayer.inPoint){
                        layer.inPoint = inPoint;
                        }
                        if(layer.outPoint> precompLayer.outPoint){
                        layer.outPoint = outPoint;
                        }
                        // 重命名
                        layer.name = layerName + "_" + (m + 1) + "_" + layer.name;
                    }

                    // 删除原始预合成图层
                    precompLayer.remove();
                }





    function applyBasicTransform(layer, transform, precompLayer){
                // 应用不透明度
        if (layer.property("Opacity")) {
            var opacity = layer.property("Opacity").value;
            layer.property("Opacity").setValue(opacity * (transform.opacity / 100));
        }

    }


    function applyTransform(layer, transform, precompLayer) {
        // 获取图层在预合成内的原始位置
        var pos = layer.property("Position").value;
            // 备用方法：手动计算（考虑旋转）
            var precompPos = precompLayer.property("Position").value;
            var precompAnchor = precompLayer.property("Anchor Point").value;
            var precompScale = precompLayer.property("Scale").value;
            var precompRotation = precompLayer.property("Rotation").value;
            
            // 计算相对于锚点的位置
            var relativeX = pos[0] - precompAnchor[0];
            var relativeY = pos[1] - precompAnchor[1];
            
            // 应用缩放
            relativeX *= precompScale[0] / 100;
            relativeY *= precompScale[1] / 100;
            
            // 应用旋转（如果有）
            if (precompRotation !== 0) {
                var rad = precompRotation * Math.PI / 180;
                var cos = Math.cos(rad);
                var sin = Math.sin(rad);
                var rotatedX = relativeX * cos - relativeY * sin;
                var rotatedY = relativeX * sin + relativeY * cos;
                relativeX = rotatedX;
                relativeY = rotatedY;
            }
            
            layer.property("Position").setValue([
                precompPos[0] + relativeX,
                precompPos[1] + relativeY,
                (precompPos[2] || 0) + (pos[2] || 0)
            ]);
        

        // 应用缩放
        var scale = layer.property("Scale").value;
        var newScale = [
            scale[0] * transform.scale[0] / 100,
            scale[1] * transform.scale[1] / 100,
            scale[2] || 100
        ];
        layer.property("Scale").setValue(newScale);
        
        // 应用旋转
        var rotation = layer.property("Rotation").value;
        layer.property("Rotation").setValue(rotation + transform.rotation);

        // 应用不透明度
        if (layer.property("Opacity")) {
            var opacity = layer.property("Opacity").value;
            layer.property("Opacity").setValue(opacity * (transform.opacity / 100));
        }
    }




        // 检查图层是否有动画并获取最早关键帧时间
        function checkIfLayerHasAnimation(layer) {
            var properties = ["Position", "Scale", "Rotation", "Opacity", "Anchor Point"];
            var earliestTime = null;
            var hasAnim = false;
            for (var i = 0; i < properties.length; i++) {
                var prop = layer.property(properties[i]);
                if (prop && prop.numKeys >= 2) {
                    hasAnim = true;
                    // 获取该属性的第一个关键帧时间
                    var firstKeyTime = prop.keyTime(1);
                    // 更新最早时间
                    if (earliestTime === null || firstKeyTime < earliestTime) {
                        earliestTime = firstKeyTime;
                    }
                }
            }
            return [hasAnim,earliestTime];
        }


}
    
    // 创建简单UI
    function createUI() {
        var win = new Window("palette", "解预合成工具", undefined);
        win.orientation = "column";
        win.spacing = 10;
        win.margins = 15;
        
        var title = win.add("statictext", undefined, "解预合成 - 保持PSR属性");
        title.alignment = ["center", "center"];
        
        var desc = win.add("statictext", undefined, "选择预合成图层后点击解预合成");
        desc.alignment = ["center", "center"];
        
        var btnGroup = win.add("group");
        var decomposeBtn = btnGroup.add("button", undefined, "解预合成");
        var closeBtn = btnGroup.add("button", undefined, "关闭");
        
        decomposeBtn.onClick = function() {
            decomposePrecompsAndKeepPSR();
        };
        
        closeBtn.onClick = function() {
            win.close();
        };
        
        return win;
    }
    
    // 运行脚本
    var ui = createUI();
    ui.show();
}
