function findTopLeft(ftl_CurLayer, ftl_time) {
    var p = 0;
    var scaleX = ftl_CurLayer.scale.value[0] / 100;
    var scaleY = ftl_CurLayer.scale.value[1] / 100;
    var scaleZ = ftl_CurLayer.scale.value[2] / 100;
    p = ftl_CurLayer.position.value;
    var preAPX = ftl_CurLayer.anchorPoint.value[0] * scaleX;
    var preAPY = ftl_CurLayer.anchorPoint.value[1] * scaleY;
    var preAPZ = ftl_CurLayer.anchorPoint.value[2] * scaleZ;
    var newLayerBounds = findMaskBounds(ftl_CurLayer, ftl_time);
    if (!ftl_CurLayer.threeDLayer) {
        var pma = p - [preAPX, preAPY];
        var rot = ftl_CurLayer.rotation.value;
        return rotatePointAroundPoint(pma + [newLayerBounds.left * scaleX, newLayerBounds.top * scaleY], p, rot);
    } else {
        var pma = p - [preAPX, preAPY, preAPZ];
        var rot = [ftl_CurLayer.xRotation.value, ftl_CurLayer.yRotation.value, ftl_CurLayer.zRotation.value];
        var orientPoint = rotate3DPointAround3DPoint(pma, p - [newLayerBounds.left * scaleX, newLayerBounds.top * scaleY], rot);
        rot = ftl_CurLayer.orientation.value;
        return rotate3DPointAround3DPoint(orientPoint + [newLayerBounds.left * scaleX, newLayerBounds.top * scaleY], p, rot);
    }
}

function findMaskBounds(fmbLayer, fmbTime) {
    var layerBounds = fmbLayer.sourceRectAtTime(fmbTime, true);
    var numMasks = fmbLayer.mask.numProperties;
    if (im.value == true) {
        return layerBounds;
    }
    if (numMasks == 0) {
        return layerBounds;
    } else if (numMasks == 1) {
        if (fmbLayer.mask(1).maskMode == MaskMode.SUBTRACT || fmbLayer.mask(1).maskMode == MaskMode.NONE || fmbLayer.mask(1).inverted) {
            return layerBounds;
        } else {
            var maskVerts = fmbLayer.mask(1).maskShape.value.vertices;
            var maskBounds = hiLowMaskVerts(maskVerts);
            var outputBounds = compareBounds(layerBounds, maskBounds);
            return outputBounds;
        }
    } else {
        if (numMasks > 1) {
            var tempBounds = layerBounds;
            var totalMaskBounds = new Array();
            totalMaskBounds[0] = 100000;
            totalMaskBounds[1] = 100000;
            totalMaskBounds[2] = -100000;
            totalMaskBounds[3] = -100000;
            for (var n = 1; n <= numMasks; n += 1) {
                if (fmbLayer.mask(n).inverted) {
                    return layerBounds;
                }
                var maskVerts = fmbLayer.mask(n).maskShape.value.vertices;
                var maskBounds = hiLowMaskVerts(maskVerts);
                if (maskBounds[0] < totalMaskBounds[0]) {
                    totalMaskBounds[0] = maskBounds[0];
                }
                if (maskBounds[1] < totalMaskBounds[1]) {
                    totalMaskBounds[1] = maskBounds[1];
                }
                if (maskBounds[2] > totalMaskBounds[2]) {
                    totalMaskBounds[2] = maskBounds[2];
                }
                if (maskBounds[3] > totalMaskBounds[3]) {
                    totalMaskBounds[3] = maskBounds[3];
                }
            }
            return compareBounds(layerBounds, totalMaskBounds);
        }
    }
}

function compareBounds(layerBounds, maskBounds) {
    var outputBounds = new Object();
    if (maskBounds[0] > layerBounds.left) {
        outputBounds.left = maskBounds[0];
    } else {
        outputBounds.left = layerBounds.left;
    }
    if (maskBounds[1] > layerBounds.top) {
        outputBounds.top = maskBounds[1];
    } else {
        outputBounds.top = layerBounds.top;
    }
    if (maskBounds[2] < layerBounds.width) {
        outputBounds.width = maskBounds[2] - outputBounds.left;
    } else {
        outputBounds.width = layerBounds.width - outputBounds.left;
    }
    if (maskBounds[3] < layerBounds.height) {
        outputBounds.height = maskBounds[3] - outputBounds.top;
    } else {
        outputBounds.height = layerBounds.height - outputBounds.top;
    }
    return outputBounds;
}

function hiLowMaskVerts(hl_maskVerts) {
    var hl_length = hl_maskVerts.length;
    var hl_left = 1000000;
    var hl_top = 1000000;
    var hl_right = -1000000;
    var hl_bottom = -1000000;
    for (var hl = 0; hl < hl_length; hl += 1) {
        var hl_curVerts = hl_maskVerts[hl];
        if (hl_curVerts[0] < hl_left) {
            hl_left = hl_curVerts[0];
        }
        if (hl_curVerts[0] > hl_right) {
            hl_right = hl_curVerts[0];
        }
        if (hl_curVerts[1] < hl_top) {
            hl_top = hl_curVerts[1];
        }
        if (hl_curVerts[1] > hl_bottom) {
            hl_bottom = hl_curVerts[1];
        }
    }
    return [hl_left, hl_top, hl_right, hl_bottom];
}

function changeCorner(ccLayer, ccTime, addCoord) {
