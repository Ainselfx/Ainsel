    ];

    function activeComp() {
        var item = app.project ? app.project.activeItem : null;
        return (item && item instanceof CompItem) ? item : null;
    }

    function isParametricMesh(layer) {
        try {
            return layer && layer.matchName === "ADBE3D ParametricMeshLayer";
        } catch (error) {
            return false;
        }
    }

    function selectedMeshLayers(comp) {
        var result = [];
        if (!comp) {
            return result;
        }
        var selected = comp.selectedLayers;
        for (var i = 0; i < selected.length; i++) {
            if (isParametricMesh(selected[i])) {
                result.push(selected[i]);
            }
        }
        return result;
    }

    function setStatus(message) {
        if (ui.status) {
            ui.status.text = message;
        }
    }

    function propertyNumber(layer, groupMatchName, propertyMatchName, time) {
        var group = layer.property(groupMatchName);
        if (!group) {
            throw new Error("\u7f3a\u5c11\u7f51\u683c\u9009\u9879\uff1a" + groupMatchName);
        }
        var property = group.property(propertyMatchName);
        if (!property) {
            throw new Error("\u7f3a\u5c11\u5c3a\u5bf8\u5c5e\u6027\uff1a" + propertyMatchName);
        }
        var value = Number(property.valueAtTime(time, false));
        if (isNaN(value) || !isFinite(value)) {
            throw new Error("\u65e0\u6cd5\u8bfb\u53d6\u5c3a\u5bf8\uff1a" + property.name);
        }
        return Math.abs(value);
    }

    function meshGroupScore(layer, matchName) {
        var group = layer.property(matchName);
        if (!group) {
            return -1;
        }
        var score = 0;
        try {
            if (group.isModified) {
                score += 1000;
            }
        } catch (ignoreGroupModified) {}
        try {
            for (var i = 1; i <= group.numProperties; i++) {
                var property = group.property(i);
                try { if (property.isModified) { score += 10; } } catch (ignoreModified) {}
                try { if (property.numKeys > 0) { score += 5; } } catch (ignoreKeys) {}
                try { if (property.expressionEnabled) { score += 5; } } catch (ignoreExpression) {}
            }
        } catch (ignoreChildren) {}
        return score;
    }

    function typeFromLayerName(layer) {
        var englishName = String(layer.name).toLowerCase();
        var originalName = String(layer.name);
        var hints = [
            { id: "cylinder", en: "cylinder", zh: "\u5706\u67f1" },
            { id: "sphere", en: "sphere", zh: "\u7403" },
            { id: "plane", en: "plane", zh: "\u5e73\u9762" },
            { id: "torus", en: "torus", zh: "\u5706\u73af" },
            { id: "cone", en: "cone", zh: "\u5706\u9525" },
            { id: "cube", en: "cube", zh: "\u7acb\u65b9" }
        ];
        for (var i = 0; i < hints.length; i++) {
            if (englishName.indexOf(hints[i].en) >= 0 || originalName.indexOf(hints[i].zh) >= 0) {
                return hints[i].id;
            }
        }
        return null;
    }

    function detectMeshType(layer) {
        var bestType = null;
        var bestScore = 0;
        for (var i = 0; i < MESH_TYPES.length; i++) {
            var score = meshGroupScore(layer, MESH_TYPES[i].group);
            if (score > bestScore) {
                bestScore = score;
                bestType = MESH_TYPES[i];
            }
        }

        if (bestType) {
            return bestType;
        }

        var nameType = typeFromLayerName(layer);
        if (nameType) {
            for (var j = 0; j < MESH_TYPES.length; j++) {
                if (MESH_TYPES[j].id === nameType) {
                    return MESH_TYPES[j];
                }
            }
        }
        throw new Error("\u65e0\u6cd5\u8bc6\u522b\u7f51\u683c\u7c7b\u578b\uff1b\u8bf7\u8c03\u6574\u4e00\u6b21\u7f51\u683c\u5c3a\u5bf8\u540e\u518d\u8bd5\u3002");
    }

    function makeCenteredBounds(xSize, ySize, zSize, type) {
        return {
            min: [-xSize * 0.5, -ySize * 0.5, -zSize * 0.5],
            max: [ xSize * 0.5,  ySize * 0.5,  zSize * 0.5],
            type: type,
            dimensions: [xSize, ySize, zSize]
        };
    }

    function meshBounds(layer, time) {
        var type = detectMeshType(layer);
        var bounds;
        var radius;
        var height;

        if (type.id === "cube") {
            bounds = makeCenteredBounds(
                propertyNumber(layer, type.group, "ADBE CubeWidthStrm", time),
                propertyNumber(layer, type.group, "ADBE CubeHeightStrm", time),
                propertyNumber(layer, type.group, "ADBE CubeDepthStrm", time),
                type
            );
        } else if (type.id === "sphere") {
            radius = propertyNumber(layer, type.group, "ADBE SphereRadiusStrm", time);
            bounds = makeCenteredBounds(radius * 2, radius * 2, radius * 2, type);
        } else if (type.id === "plane") {
            var width = propertyNumber(layer, type.group, "ADBE PlaneWidthStrm", time);
            var length = propertyNumber(layer, type.group, "ADBE PlaneLengthStrm", time);
            bounds = makeCenteredBounds(width, length, 0, type);
        } else if (type.id === "torus") {
            var ringRadius = propertyNumber(layer, type.group, "ADBE TorusRingRadiusStrm", time);
            var pipeRadius = propertyNumber(layer, type.group, "ADBE TorusPipeRadiusStrm", time);
            var outerRadius = ringRadius + pipeRadius;
            bounds = makeCenteredBounds(outerRadius * 2, pipeRadius * 2, outerRadius * 2, type);
        } else if (type.id === "cone") {
            var topRadius = propertyNumber(layer, type.group, "ADBE ConeTopRadiusStrm", time);
            var bottomRadius = propertyNumber(layer, type.group, "ADBE ConeBottomRadiusStrm", time);
            radius = Math.max(topRadius, bottomRadius);
            height = propertyNumber(layer, type.group, "ADBE ConeHeightStrm", time);
            bounds = makeCenteredBounds(radius * 2, height, radius * 2, type);
        } else if (type.id === "cylinder") {
            radius = propertyNumber(layer, type.group, "ADBE CylinderRadiusStrm", time);
            height = propertyNumber(layer, type.group, "ADBE CylinderHeightStrm", time);
            bounds = makeCenteredBounds(radius * 2, height, radius * 2, type);
        } else {
            throw new Error("\u4e0d\u652f\u6301\u7684\u7f51\u683c\u7c7b\u578b\u3002");
        }
        return bounds;
    }

    function lerp(minValue, maxValue, amount) {
        return minValue + (maxValue - minValue) * amount;
    }

    function pointFromBounds(bounds, normalizedPoint) {
        return [
            lerp(bounds.min[0], bounds.max[0], normalizedPoint[0]),
            lerp(bounds.min[1], bounds.max[1], normalizedPoint[1]),
            lerp(bounds.min[2], bounds.max[2], normalizedPoint[2])
        ];
    }

    function normalizedPointForFace(faceIndex, row, column) {
        var u = column * 0.5;
        var v = row * 0.5;
        switch (faceIndex) {
            case 0: return [u, v, 0];
            case 1: return [u, v, 1];
            case 2: return [0, v, 1 - u];
            case 3: return [1, v, u];
            case 4: return [u, 0, 1 - v];
            case 5: return [u, 1, 1 - v];
        }
        return [0.5, 0.5, 0.5];
    }

    function propertyHasExpression(property) {
        try {
            return property.canSetExpression && property.expressionEnabled;
        } catch (error) {
            return false;
        }
    }

    function positionHasExpression(position) {
        if (propertyHasExpression(position)) {
            return true;
        }
        try {
            if (position.dimensionsSeparated) {
                for (var i = 0; i < position.value.length; i++) {
                    if (propertyHasExpression(position.getSeparationFollower(i))) {
                        return true;
                    }
                }
            }
        } catch (error) {}
        return false;
    }

    function positionHasKeys(position) {
        if (position.numKeys > 0) {
            return true;
        }
        try {
            if (position.dimensionsSeparated) {
                for (var i = 0; i < position.value.length; i++) {
                    if (position.getSeparationFollower(i).numKeys > 0) {
                        return true;
                    }
                }
            }
        } catch (error) {}
        return false;
    }

    function setPropertyValue(property, value, time, forceKeyframe) {
        if (forceKeyframe || property.numKeys > 0) {
            property.setValueAtTime(time, value);
        } else {
            property.setValue(value);
        }
    }

    function setPositionValue(position, value, time, forceKeyframe) {
        if (position.dimensionsSeparated) {
            for (var i = 0; i < value.length; i++) {
                setPropertyValue(position.getSeparationFollower(i), value[i], time, forceKeyframe);
            }
        } else {
            setPropertyValue(position, value, time, forceKeyframe);
        }
    }

    function expressionNumber(value) {
        return Math.abs(value) < EPSILON ? "0" : String(value);
    }

    function restoreSelection(comp, layers) {
        var i;
        for (i = 1; i <= comp.numLayers; i++) {
            try { comp.layer(i).selected = false; } catch (ignoreDeselect) {}
        }
        for (i = 0; i < layers.length; i++) {
            try { layers[i].selected = true; } catch (ignoreSelect) {}
        }
    }

    function transformedAnchorDelta(comp, layer, targetAnchor, selectionToRestore) {
        var tempLayer = null;
        try {
            tempLayer = comp.layers.addNull();
            tempLayer.name = "__ModelAnchor27_Temporary__";
            tempLayer.threeDLayer = true;
            var targetIndex = layer.index;
            var tempPosition = tempLayer.property("ADBE Transform Group").property("ADBE Position");
            var pointText = "[" + expressionNumber(targetAnchor[0]) + "," + expressionNumber(targetAnchor[1]) + "," + expressionNumber(targetAnchor[2]) + "]";
            tempPosition.expression =
                "var L=thisComp.layer(" + targetIndex + ");\n" +
                "var w1=L.toWorld(" + pointText + ");\n" +
                "var w0=L.toWorld(L.anchorPoint);\n" +
                "var p1,p0;\n" +
                "if(L.hasParent){p1=L.parent.fromWorld(w1);p0=L.parent.fromWorld(w0);}\n" +
                "else{p1=w1;p0=w0;}\n" +
                "[p1[0]-p0[0],p1[1]-p0[1],p1[2]-p0[2]];";
            var expressionError = tempPosition.expressionError;
            if (expressionError && expressionError.length) {
                throw new Error(expressionError);
            }
            var delta = tempPosition.valueAtTime(comp.time, false);
            if (!delta || delta.length !== 3) {
                throw new Error("\u65e0\u6cd5\u8ba1\u7b97\u4e09\u7ef4\u4f4d\u7f6e\u8865\u507f\u3002");
            }
            return [delta[0], delta[1], delta[2]];
        } finally {
            if (tempLayer) {
                try { tempLayer.remove(); } catch (ignoreRemove) {}
            }
            restoreSelection(comp, selectionToRestore);
        }
    }

    function moveLayerAnchor(comp, layer, targetAnchor, selectionToRestore) {
        var transform = layer.property("ADBE Transform Group");
        var anchor = transform.property("ADBE Anchor Point");
        var position = transform.property("ADBE Position");
        if (propertyHasExpression(anchor) || positionHasExpression(position)) {
            throw new Error("\u951a\u70b9\u6216\u4f4d\u7f6e\u6b63\u5728\u4f7f\u7528\u8868\u8fbe\u5f0f\u3002");
        }

        var originalLocked = layer.locked;
        try {
            if (originalLocked) {
                layer.locked = false;
            }
            var oldPosition = position.valueAtTime(comp.time, false);
            var delta = transformedAnchorDelta(comp, layer, targetAnchor, selectionToRestore);
            var newPosition = [oldPosition[0] + delta[0], oldPosition[1] + delta[1], oldPosition[2] + delta[2]];
            var useKeyframe = anchor.numKeys > 0 || positionHasKeys(position);
            setPropertyValue(anchor, targetAnchor, comp.time, useKeyframe);
            setPositionValue(position, newPosition, comp.time, useKeyframe);
        } finally {
            if (originalLocked) {
                layer.locked = true;
            }
        }
    }

    function formatNumber(value) {
        return String(Math.round(value * 1000) / 1000);
    }

    function dimensionsText(bounds) {
        return formatNumber(bounds.dimensions[0]) + " \u00d7 " + formatNumber(bounds.dimensions[1]) + " \u00d7 " + formatNumber(bounds.dimensions[2]);
    }

    function refreshSelectionInfo() {
        var comp = activeComp();
        var layers = selectedMeshLayers(comp);
        if (!layers.length) {
            setStatus("\u8bf7\u9009\u62e9 AE 2026 \u53c2\u6570\u5316\u7f51\u683c\u56fe\u5c42\u3002");
            return;
        }
        var details = [];
        for (var i = 0; i < layers.length; i++) {
            try {
                var bounds = meshBounds(layers[i], comp.time);
                details.push(layers[i].name + "\uff1a" + bounds.type.label + " " + dimensionsText(bounds));
            } catch (error) {
                details.push(layers[i].name + "\uff1a" + error.toString().replace(/^Error:\s*/, ""));
            }
        }
        setStatus(details.join("\uff1b"));
    }

    function moveSelectedTo(normalizedPoint, pointLabel) {
        var comp = activeComp();
        var layers = selectedMeshLayers(comp);
        if (!comp || !layers.length) {
            setStatus("\u8bf7\u5148\u9009\u62e9\u4e00\u4e2a\u6216\u591a\u4e2a AE 2026 \u53c2\u6570\u5316\u7f51\u683c\u56fe\u5c42\u3002");
            return;
        }

        var moved = 0;
        var skipped = [];
        app.beginUndoGroup(SCRIPT_NAME + " - " + pointLabel);
        try {
            for (var i = 0; i < layers.length; i++) {
                try {
                    var bounds = meshBounds(layers[i], comp.time);
                    moveLayerAnchor(comp, layers[i], pointFromBounds(bounds, normalizedPoint), layers);
                    moved++;
                } catch (error) {
                    skipped.push(layers[i].name + "\uff08" + error.toString().replace(/^Error:\s*/, "") + "\uff09");
                }
            }
        } finally {
            restoreSelection(comp, layers);
            app.endUndoGroup();
        }

        var message = "\u5df2\u81ea\u52a8\u8bfb\u53d6\u5c3a\u5bf8\uff0c\u79fb\u52a8 " + moved + " \u4e2a\u7f51\u683c\u5230\u201c" + pointLabel + "\u201d\u3002";
        if (skipped.length) {
            message += " \u8df3\u8fc7\uff1a" + skipped.join("\u3001");
        }
        setStatus(message);
    }

    function localNormalForFace(faceIndex) {
        switch (faceIndex) {
            case 0: return [0, 0, -1];
            case 1: return [0, 0, 1];
            case 2: return [-1, 0, 0];
            case 3: return [1, 0, 0];
            case 4: return [0, -1, 0];
            case 5: return [0, 1, 0];
        }
        return [0, -1, 0];
    }

    function localTangentsForFace(faceIndex) {
        switch (faceIndex) {
            case 0: return [[1, 0, 0], [0, -1, 0]];
            case 1: return [[1, 0, 0], [0, 1, 0]];
            case 2: return [[0, 0, 1], [0, 1, 0]];
            case 3: return [[0, 0, 1], [0, -1, 0]];
            case 4: return [[1, 0, 0], [0, 0, 1]];
            case 5: return [[1, 0, 0], [0, 0, -1]];
        }
        return [[1, 0, 0], [0, 0, 1]];
    }

    function vectorExpression(value) {
        return "[" + expressionNumber(value[0]) + "," + expressionNumber(value[1]) + "," + expressionNumber(value[2]) + "]";
    }

    function sourceBottomCenter(bounds) {
        return [0, bounds.max[1], 0];
    }

    function sourceBottomSurfacePoints(bounds) {
        if (bounds.type && bounds.type.id === "sphere") {
            return [[0, bounds.max[1], 0]];
        }
        return [
            [bounds.min[0], bounds.max[1], bounds.min[2]],
            [bounds.max[0], bounds.max[1], bounds.min[2]],
            [bounds.min[0], bounds.max[1], bounds.max[2]],
            [bounds.max[0], bounds.max[1], bounds.max[2]]
        ];
    }

    function closestFaceIndices(bounds) {
        if (bounds.type && bounds.type.id === "plane") {
            return [0, 1];
        }
        return [0, 1, 2, 3, 4, 5];
    }

    function closestPointExpressionForFace(faceIndex) {
        var x = "clamp(Q[0],MN[0],MX[0])";
        var y = "clamp(Q[1],MN[1],MX[1])";
        var z = "clamp(Q[2],MN[2],MX[2])";
        switch (faceIndex) {
            case 0: return "[" + x + "," + y + ",MN[2]]";
            case 1: return "[" + x + "," + y + ",MX[2]]";
            case 2: return "[MN[0]," + y + "," + z + "]";
            case 3: return "[MX[0]," + y + "," + z + "]";
            case 4: return "[" + x + ",MN[1]," + z + "]";
            case 5: return "[" + x + ",MX[1]," + z + "]";
        }
        return "[" + x + ",MN[1]," + z + "]";
    }

    function closestFacePointsExpression(faceIndices) {
        var points = [];
        for (var i = 0; i < faceIndices.length; i++) {
            points.push(closestPointExpressionForFace(faceIndices[i]));
        }
        return "[" + points.join(",") + "]";
    }

    function faceIndicesExpression(faceIndices) {
        return "[" + faceIndices.join(",") + "]";
    }

    function vectorArrayExpression(values) {
        var result = [];
        for (var i = 0; i < values.length; i++) {
            result.push(vectorExpression(values[i]));
        }
        return "[" + result.join(",") + "]";
    }

    function faceTangentsExpression(componentIndex) {
        var values = [];
        for (var i = 0; i < 6; i++) {
            values.push(vectorExpression(localTangentsForFace(i)[componentIndex]));
        }
        return "[" + values.join(",") + "]";
    }

    function surfaceFrameSetupExpression(sourceIndex, targetIndex, bottomCenter, targetBounds, faceIndices) {
        return (
            "var S=thisComp.layer(" + sourceIndex + ");\n" +
            "var T=thisComp.layer(" + targetIndex + ");\n" +
            "var B=S.toWorld(" + vectorExpression(bottomCenter) + ");\n" +
            "var Q=T.fromWorld(B);\n" +
            "var MN=" + vectorExpression(targetBounds.min) + ";\n" +
            "var MX=" + vectorExpression(targetBounds.max) + ";\n" +
            "var FI=" + faceIndicesExpression(faceIndices) + ";\n" +
            "var LC=" + closestFacePointsExpression(faceIndices) + ";\n" +
            "var W=T.toWorld(LC[0]);\n" +
            "var F=FI[0];\n" +
            "var best=length(sub(W,B));\n" +
            "for(var i=1;i<LC.length;i++){var C=T.toWorld(LC[i]);var d=length(sub(C,B));if(d<best){best=d;W=C;F=FI[i];}}\n" +
            "var AU=" + faceTangentsExpression(0) + ";\n" +
            "var AV=" + faceTangentsExpression(1) + ";\n" +
            "if(FI.length==2){var F0=FI[0];var PN=normalize(cross(T.toWorldVec(AU[F0]),T.toWorldVec(AV[F0])));F=dot(sub(S.toWorld([0,0,0]),W),PN)>=0?FI[0]:FI[1];}\n" +
            "var U0=T.toWorldVec(AU[F]);\n" +
            "var V0=T.toWorldVec(AV[F]);\n" +
            "var N=normalize(cross(U0,V0));\n" +
            "var U=normalize(sub(U0,mul(N,dot(U0,N))));\n" +
            "var D=mul(N,-1);\n"
        );
    }

    function layerIsAncestorOf(ancestor, layer) {
        var current = null;
        try { current = layer.parent; } catch (ignoreParent) {}
        while (current) {
            if (current === ancestor) {
                return true;
            }
            try { current = current.parent; } catch (ignoreNextParent) { current = null; }
        }
        return false;
    }

    function layerParentDepth(layer) {
        var depth = 0;
        var current = null;
        try { current = layer.parent; } catch (ignoreParent) {}
        while (current && depth < 1000) {
            depth++;
            try { current = current.parent; } catch (ignoreNextParent) { current = null; }
        }
        return depth;
    }

    function normalSurfaceDelta(comp, sourceLayer, bottomCenter, supportPoints, targetLayer, targetBounds, faceIndices, selectionToRestore) {
        var probe = null;
        try {
            probe = comp.layers.addNull();
            probe.name = "__ModelNormalSurfaceAlign_Temporary__";
            probe.threeDLayer = true;
            var sourceIndex = sourceLayer.index;
            var targetIndex = targetLayer.index;
            var setup = surfaceFrameSetupExpression(sourceIndex, targetIndex, bottomCenter, targetBounds, faceIndices);
            var probePosition = probe.property("ADBE Transform Group").property("ADBE Position");
            probePosition.expression =
                setup +
                "var SP=" + vectorArrayExpression(supportPoints) + ";\n" +
                "var minD=dot(sub(S.toWorld(SP[0]),W),N);\n" +
                "for(var j=1;j<SP.length;j++){var sd=dot(sub(S.toWorld(SP[j]),W),N);if(sd<minD)minD=sd;}\n" +
                "var A=S.toWorld(S.anchorPoint);\n" +
                "var AW=add(A,mul(N,-minD));\n" +
                "var q1,q0;\n" +
                "if(S.hasParent){q1=S.parent.fromWorld(AW);q0=S.parent.fromWorld(A);}\n" +
                "else{q1=AW;q0=A;}\n" +
                "sub(q1,q0);";
            var expressionError = probePosition.expressionError;
            if (expressionError && expressionError.length) {
                throw new Error(expressionError);
            }
            var delta = probePosition.valueAtTime(comp.time, false);
            if (!delta || delta.length !== 3 || !isFinite(delta[0]) || !isFinite(delta[1]) || !isFinite(delta[2]) || Math.abs(delta[0]) > 1000000000 || Math.abs(delta[1]) > 1000000000 || Math.abs(delta[2]) > 1000000000) {
                throw new Error("\u65e0\u6cd5\u8ba1\u7b97\u6cbf\u76ee\u6807\u9762\u6cd5\u7ebf\u7684\u5bf9\u9f50\u4f4d\u79fb\u3002");
            }
            return [delta[0], delta[1], delta[2]];
        } finally {
            if (probe) {
                try { probe.remove(); } catch (ignoreRemove) {}
            }
            restoreSelection(comp, selectionToRestore);
        }
    }

    function alignLayerSurface(comp, sourceLayer, bottomCenter, supportPoints, targetLayer, targetBounds, faceIndices, selectionToRestore) {
        var delta = normalSurfaceDelta(comp, sourceLayer, bottomCenter, supportPoints, targetLayer, targetBounds, faceIndices, selectionToRestore);
        offsetLayerPosition(comp, sourceLayer, delta);
    }

    function offsetLayerPosition(comp, layer, delta) {
        var position = layer.property("ADBE Transform Group").property("ADBE Position");
        if (!position || positionHasExpression(position)) {
            throw new Error("\u4f4d\u7f6e\u6b63\u5728\u4f7f\u7528\u8868\u8fbe\u5f0f\u6216\u4e0d\u53ef\u7f16\u8f91\u3002");
        }
        var originalLocked = layer.locked;
        try {
            if (originalLocked) {
                layer.locked = false;
            }
            var oldPosition = position.valueAtTime(comp.time, false);
            var newPosition = [oldPosition[0] + delta[0], oldPosition[1] + delta[1], oldPosition[2] + delta[2]];
            setPositionValue(position, newPosition, comp.time, positionHasKeys(position));
        } finally {
            if (originalLocked) {
                layer.locked = true;
            }
        }
    }

    function alignSelectedBottoms() {
        var comp = activeComp();
        if (!comp) {
            setStatus("\u8bf7\u5148\u6253\u5f00\u5408\u6210\u5e76\u9009\u62e9\u56fe\u5c42\u3002");
            return;
        }

        var selected = comp.selectedLayers;
        if (selected.length < 2) {
            setStatus("\u8bf7\u6309\u987a\u5e8f\u9009\u62e9\u81f3\u5c11\u4e24\u4e2a\u7f51\u683c\uff1b\u6700\u540e\u9009\u4e2d\u7684\u4f5c\u4e3a\u76ee\u6807\u3002");
            return;
        }

        var target = selected[selected.length - 1];
        if (!isParametricMesh(target)) {
            setStatus("\u6700\u540e\u9009\u4e2d\u7684\u56fe\u5c42\u5fc5\u987b\u662f AE 2026 \u53c2\u6570\u5316\u7f51\u683c\u3002");
            return;
        }

        var sources = [];
        var unsupported = [];
        for (var i = 0; i < selected.length - 1; i++) {
            if (isParametricMesh(selected[i])) {
                if (layerIsAncestorOf(selected[i], target)) {
                    unsupported.push(selected[i].name + "\uff08\u662f\u76ee\u6807\u7684\u7236\u7ea7\uff0c\u79fb\u52a8\u5b83\u4f1a\u5e26\u52a8\u76ee\u6807\uff09");
                } else {
                    sources.push(selected[i]);
                }
            } else {
                unsupported.push(selected[i].name + "\uff08\u4e0d\u662f\u53c2\u6570\u5316\u7f51\u683c\uff09");
            }
        }
        if (!sources.length) {
            setStatus("\u76ee\u6807\u4e4b\u524d\u6ca1\u6709\u53ef\u8d34\u5408\u7684\u53c2\u6570\u5316\u7f51\u683c\u3002");
            return;
        }
        sources.sort(function (a, b) {
            return layerParentDepth(a) - layerParentDepth(b);
        });

        var targetBounds;
        try {
            targetBounds = meshBounds(target, comp.time);
        } catch (targetBoundsError) {
