function simple() {
    if (sl.length == 1 || hasSuffix == false) {
        for (var i = 0; i < sl.length; i += 1) {
            if (filter(i) == false) {
                continue;
            }
            sl[i].name = newName;
        }
    } else {
        var j = 0;
        var t = 0;
        for (var i = 0; i < sl.length; i += 1) {
            if (filter(i) == false) {
                continue;
            }
            j += 1;
            t = i;
            if (j <= 9) {
                sl[i].name = newName + "_00" + j;
            } else if (j <= 99) {
                sl[i].name = newName + "_0" + j;
            } else {
                sl[i].name = newName + "_" + j;
            }
        }
        if (j == 1) {
            sl[t].name = newName
        }
    }
