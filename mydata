    };

    excludehidelayers.onClick = function() {
        settings.excludehidelayers = excludehidelayers.value;
        statusText.text = "已" + (settings.excludehidelayers ? "启用" : "禁用") + "排除隐藏层";
    };

    // 深度遍历合成，构建扁平结构
    function buildFlatStructure(comp, visitedComps) {
        if (!comp || !(comp instanceof CompItem)) {return [];}
        // 初始化已访问合成数组
        if (!visitedComps) {visitedComps = [];}
        // 检查是否已经访问过这个合成，避免无限循环
        if (visitedComps.indexOf(comp) !== -1) {return [];}
        // 标记当前合成为已访问
        visitedComps.push(comp);
        var nodes = [];
        
        if (settings.reverseOrder) {
            // 倒序遍历（从下往上）
            for (var i = comp.numLayers; i >= 1; i--) {
                var layer = comp.layer(i);
                processLayer(comp, layer, nodes, visitedComps);
            }
        } else {
            // 正序遍历（从上往下）
            for (var i = 1; i <= comp.numLayers; i++) {
                var layer = comp.layer(i);
                processLayer(comp, layer, nodes, visitedComps);
            }
        }
        
        return nodes;
    }

    // 处理图层
    function processLayer(comp, layer, nodes, visitedComps) {
        if(settings.excludehidelayers){if (!layer.enabled) {return;}}// 跳过不可见图层
        // 检查是否应该处理这个图层
        var shouldProcess = false;
        var layerType = "";
        
            // 根据设置决定处理哪些图层
            if (settings.excludeTextLayers && settings.excludeCommentlayers) {
                // 两种都排除，不处理任何图层
                shouldProcess = false;
            } else if (settings.excludeTextLayers) {
                // 只处理注释层
                shouldProcess = layer.comment && layer.comment.toString().toLowerCase().includes("text");
                layerType = "comment";
            } else if (settings.excludeCommentlayers) {
                // 只处理文本层
                shouldProcess = layer instanceof TextLayer;
                layerType = "text";
            } else {
                // 处理两种类型的图层
                if (layer instanceof TextLayer) {
                    shouldProcess = true;
                    layerType = "text";
                } else if (layer.comment && layer.comment.toString().toLowerCase().includes("text")) {
                    shouldProcess = true;
                    layerType = "comment";
                }
            }
        
        if (shouldProcess) {
            try {
                var textContent = "";
                
                // 检查文本层
                if (layer instanceof TextLayer) {
                    var sourceText = layer.property("Source Text");
                    if (sourceText && sourceText.value) {
                        textContent = sourceText.value.toString().replace(/\r?\n|\r/g, " ");
                    }
                }
                // 检查注释包含Text
                else if (layer.comment && layer.comment.toString().toLowerCase().indexOf("text") !== -1) {
                    textContent = "注释标记层";
                }
                
                if (textContent) {
                    var layerNode = {
                        type: "layer",
                        name: layer.name,
                        compName: comp.name,
                        text: comp.name + " > " + layer.name + " | " + textContent,
                        textContent: textContent,
                        targetComp: comp,
                        targetLayer: layer,
                        layerType: layerType,
                        layerIndex: layer.index
                    };
                    nodes.push(layerNode);
                }
            } catch (e) {
                var layerNode = {
                    type: "layer",
                    name: layer.name,
                    compName: comp.name,
                    text: comp.name + " > " + layer.name + " | [读取错误]",
                    textContent: "[读取错误]",
                    targetComp: comp,
                    targetLayer: layer,
                    layerType: "error",
                    layerIndex: layer.index
                };
                nodes.push(layerNode);
            }
        }
        
        // 如果是预合成图层，递归遍历（深度遍历）
        if (layer.source instanceof CompItem && layer !== comp) {
            var subComp = layer.source;
            // 递归遍历子合成，传递已访问合成数组
            var subNodes = buildFlatStructure(subComp, visitedComps);
            for (var k = 0; k < subNodes.length; k++) {
                nodes.push(subNodes[k]);
            }
        }
    }
    
    // 填充列表
    function populateListView(nodes) {
        treeView.removeAll();
        for (var i = 0; i < nodes.length; i++) {
            var node = nodes[i];
            var listItem = treeView.add("item", node.text);
            listItem.nodeData = node;
        }
    }
    
    // 刷新列表显示
    function refreshListViewDisplay() {
        populateListView(listData);
    }
    
    // 查找合成和图层
    function findCompAndLayer(nodeData) {
        try {
            if (nodeData.targetComp) {
                nodeData.targetComp.openInViewer();
                
                if (nodeData.targetLayer) {
                    nodeData.targetLayer.selected = true;
                    var time = nodeData.targetLayer.inPoint;
                    nodeData.targetComp.time = time;
                    statusText.text = "已定位到: " + nodeData.compName + " > " + nodeData.name;
                }
            }
            return nodeData.targetComp;
        } catch (error) {
            statusText.text = "定位失败: " + error.toString();
        }
    }

    // 添加选择层函数 - 支持任意图层，添加Text注释，根据设置排序
    function addItemAbove() {
        try {
            var selectedLayers = getSelectedLayerInfo();
            if (!selectedLayers || selectedLayers.length === 0) {
                alert("请在AE中先选中一个或多个图层！");
                return;
            }
            
            var addedCount = 0;
            var existCount = 0;
            var lastAddedNode = null; // 记录最后添加的节点
            
            // 根据设置决定处理顺序
            var layersToProcess = settings.reverseOrder ? 
                selectedLayers.slice().reverse() : // 倒序处理
                selectedLayers; // 正序处理
            
            for (var i = 0; i < layersToProcess.length; i++) {
                var layerInfo = layersToProcess[i];
                
                var exists = false;
                // 检查是否已存在
                for (var j = 0; j < listData.length; j++) {
                    if (listData[j].targetLayer === layerInfo.targetLayer) {
                        exists = true;
                        existCount++;
                        break;
                    }
                }

                if (!exists) {
                    // 给图层添加Text注释
                    try {
                        layerInfo.targetLayer.comment = "Text";
                    } catch (e) {
                        // 如果添加注释失败，继续处理
                    }
                    
                    // 创建节点数据
                    var node = {
                        type: "layer",
                        name: layerInfo.name,
                        compName: layerInfo.targetComp.name,
                        text: layerInfo.targetComp.name + " > " + layerInfo.name + " | " + layerInfo.textContent,
                        textContent: layerInfo.textContent,
                        targetComp: layerInfo.targetComp,
                        targetLayer: layerInfo.targetLayer,
                        layerType: layerInfo.layerType,
                        layerIndex: layerInfo.layerIndex
                    };
                    
                    // 按照图层索引插入到正确位置
                    insertLayerAtCorrectPosition(node);
                    addedCount++;
                    lastAddedNode = node; // 记录最后添加的节点
                }
            }
            
            if (addedCount === 0) {
                statusText.text = "选中的图层已存在于列表中（共 " + existCount + " 个）";
                return;
            }
            
            // 刷新显示
            refreshListViewDisplay();
            
            // 在UI中选中最后添加的图层
            if (lastAddedNode) {
                selectNodeInTreeView(lastAddedNode);
            }
            
            if (existCount > 0) {
                statusText.text = "已添加 " + addedCount + " 个图层，跳过 " + existCount + " 个已存在的图层";
            } else {
                statusText.text = "已添加 " + addedCount + " 个图层到列表";
            }

        } catch (error) {
            alert("添加失败: " + error.toString());
            statusText.text = "添加失败: " + error.toString();
        }
    }

    // 在TreeView中选中指定节点
    function selectNodeInTreeView(nodeToSelect) {
        for (var i = 0; i < treeView.items.length; i++) {
            var item = treeView.items[i];
            if (item.nodeData === nodeToSelect) {
                treeView.selection = item;
                currentSelectedNode = nodeToSelect;
                currentSelectedTreeItem = item;
                
                // 更新编辑框内容
                if (nodeToSelect.layerType === "text") {
                    editText.text = nodeToSelect.textContent;
                } else {
                    editText.text = "";
                }
                
                statusText.text = "已选中: " + nodeToSelect.compName + " > " + nodeToSelect.name;
                break;
            }
        }
    }

    // 按照图层索引插入到正确位置
    function insertLayerAtCorrectPosition(newNode) {
        if (listData.length === 0) {
            listData.push(newNode);
            return;
        }
        
        // 根据设置决定排序方式
        if (settings.reverseOrder) {
            // 倒序排列：图层索引从大到小
            var insertIndex = 0;
            for (var i = 0; i < listData.length; i++) {
                if (listData[i].layerIndex < newNode.layerIndex) {
                    insertIndex = i;
                    break;
                }
                if (i === listData.length - 1) {
                    insertIndex = listData.length;
                }
            }
            listData.splice(insertIndex, 0, newNode);
        } else {
            // 正序排列：图层索引从小到大
            var insertIndex = listData.length;
            for (var i = 0; i < listData.length; i++) {
                if (listData[i].layerIndex > newNode.layerIndex) {
                    insertIndex = i;
                    break;
                }
            }
            listData.splice(insertIndex, 0, newNode);
        }
    }

    // 获取选中图层信息 - 支持任意图层类型
    function getSelectedLayerInfo() {
        try {
            var activeComp = app.project.activeItem;
            if (!activeComp || !(activeComp instanceof CompItem)) {
                return null;
            }
            
            var selectedLayers = [];
            
            if (settings.reverseOrder) {
                // 倒序遍历（从下往上）
                for (var i = activeComp.numLayers; i >= 1; i--) {
                    var layer = activeComp.layer(i);
                    if (layer.selected) {
                        processSelectedLayer(activeComp, layer, selectedLayers);
                    }
                }
            } else {
                // 正序遍历（从上往下）
                for (var i = 1; i <= activeComp.numLayers; i++) {
                    var layer = activeComp.layer(i);
                    if (layer.selected) {
                        processSelectedLayer(activeComp, layer, selectedLayers);
                    }
                }
            }

            return selectedLayers;
        } catch (error) {
            return null;
        }
    }

    // 处理选中的图层
    function processSelectedLayer(comp, layer, selectedLayers) {
        var layerInfo = {
            type: "layer",
            name: layer.name,
            targetComp: comp,
            targetLayer: layer,
            layerIndex: layer.index,
            children: []
        };
        
        // 如果是文本层，提取文本内容
        if (layer instanceof TextLayer) {
            try {
                var sourceText = layer.property("Source Text");
                if (sourceText && sourceText.value) {
                    var textContent = sourceText.value.toString().replace(/\r?\n|\r/g, " ");
                    layerInfo.text = layer.name + " | " + textContent;
                    layerInfo.textContent = textContent;
                    layerInfo.layerType = "text";
                }
            } catch (e) {
                layerInfo.text = layer.name + " | [文本读取错误]";
                layerInfo.textContent = "[文本读取错误]";
                layerInfo.layerType = "text";
            }
        } else {
            // 非文本层
            layerInfo.text = layer.name + " | [非文本层]";
            layerInfo.textContent = "[非文本层]";
            layerInfo.layerType = "other";
        }
        
        selectedLayers.push(layerInfo);
    }

    // 更新文本内容函数 - 只对文本层有效
    function updateTextContent() {
        for (var i = 0; i < currentSelectedNode.length; i++){
            currentSelectedNodelayer = currentSelectedNode[i].nodeData;
        if (!currentSelectedNodelayer || currentSelectedNodelayer.type !== "layer") {
            alert("请先选择一个图层！");
            return;
        }

        // 只有文本层才能更新文本内容
        if (currentSelectedNodelayer.layerType !== "text") {
            alert("只有文本层才能更新文本内容！");
            return;
        }
        
        var newText = editText.text;
        
        if (!newText) {
            alert("文本内容不能为空！");
            return;
        }

        try {
            if (currentSelectedNodelayer.targetLayer) {
                var sourceText = currentSelectedNodelayer.targetLayer.property("Source Text");
                sourceText.setValue(newText);
            }

            // 更新当前节点的数据
            currentSelectedNodelayer.textContent = newText.replace(/\r?\n|\r/g, " ");
            currentSelectedNodelayer.text = currentSelectedNodelayer.compName + " > " + currentSelectedNodelayer.name + " | " + currentSelectedNodelayer.textContent;

            // 更新TreeView中当前项的显示文本
            if (currentSelectedTreeItem) {
                currentSelectedTreeItem[i].text = currentSelectedNodelayer.text;
            }

            statusText.text = "文本内容已更新！";
            treeView.active = true;
        } catch (error) {
            alert("更新失败: " + error.toString());
            statusText.text = "更新失败: " + error.toString();
        }
    }}

    // 删除函数 - 同时清除图层注释，删除后选择上一个列表项
    function deleteItem() {
        if (!currentSelectedNode) {
            alert("请先在列表中选择一个图层！");
            return;
        }
        
        try {
            // 获取当前选中项的索引
            var currentIndex = listData.indexOf(currentSelectedNode);
            
            // 清除图层注释
            if (currentSelectedNode.targetLayer) {
                try {
                    currentSelectedNode.targetLayer.comment = "";
                } catch (e) {
                    // 如果清除注释失败，继续处理
                }
            }
            
            // 直接从数组中删除
            var index = listData.indexOf(currentSelectedNode);
            if (index !== -1) {
                listData.splice(index, 1);
            }
            
            // 刷新显示
            refreshListViewDisplay();
            
            // 选择上一个列表项（如果存在）
            if (listData.length > 0) {
                var newIndex = Math.max(0, currentIndex - 1);
                var newNode = listData[newIndex];
                
                // 在UI中选中上一个项
                selectNodeInTreeView(newNode);
                
                statusText.text = "已删除列表项，选中了上一个项";
            } else {
                // 如果没有项了，清空选择
                editText.text = "";
                currentSelectedNode = null;
                currentSelectedTreeItem = null;
                statusText.text = "已删除列表项，列表已空";
            }
            
        } catch (error) {
            alert("删除失败: " + error.toString());
            statusText.text = "删除失败: " + error.toString();
        }
    }

