    function splitkimoLay(selectobj, he, wh, x, y, z, tree, rotaz, rotax, rotay, Orie, kaz, iti, an1, an2, an3, sca) {
        var dura = selectobj.outPoint - selectobj.inPoint;
        var pura = 0;
        var co = [];
        var colist = [];
        var wwh = wh;
        var hhe = he;
        var posda = wh / kaz;
        wwh = wh / kaz;
        wwh = Math.ceil(wwh);
        if (wwh < 4) {
            kau = 0;
            for (var i = 0; i < 2; i += 1) {
                kau++;
                if (wh / kau < 3.0005) {
                    kau -= 1;
                } else {
                    i = 0;
                }
            }
            if (Aslang) {
                keiko_split.text = '幅が4ピクセル未満になるため分割できません。分割数は最大' + kau + 'までです。';
                splitflag == false;
