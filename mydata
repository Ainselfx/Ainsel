function calculateSmoothSpeed(prev2Speed, prev1Speed, currSpeed, next1Speed, next2Speed) {
    // 1. 将5帧速度视为时间序列（时间点：t = -2, -1, 0, 1, 2）
    var speeds = [prev2Speed, prev1Speed, currSpeed, next1Speed, next2Speed];
    var n = speeds.length;

    // 2. 计算线性回归所需的各项和
    var sumT = 0, sumT2 = 0, sumV = 0, sumTV = 0;
    for (var t = -2; t <= 2; t++) {
        var speed = speeds[t + 2];
        sumT += t;
        sumT2 += t * t;
        sumV += speed;
        sumTV += t * speed;
    }

    // 3. 计算回归系数（V = a + b*t）
    var b = (n * sumTV - sumT * sumV) / (n * sumT2 - sumT * sumT);
    var a = (sumV - b * sumT) / n;

    // 4. 当前时刻（t=0）的拟合值即为平滑速度
    var smoothSpeed = a;

