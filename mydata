            for (var i = 0; i < props.length; i += 1) {
                var keys = sortNumbers(props[i].selectedKeys, 1);
                if (time > props[i].keyTime(keys[0])) {
                    time = props[i].keyTime(keys[0])
                }
            }
            return time;
        }

        function deselectOtherProps(propsObj, curProp) {
            for (var i = 0; i < propsObj.length; i += 1) {
                if (propsObj[i].prop === curProp) {
                    continue;
                } else {
                    propsObj[i].prop.selected = false
                }
            }
        }

        function selectOtherProperties(propsObj, curProp) {
            for (var i = 0; i < propsObj.length; i += 1) {
                prop = propsObj[i].prop;
                if (prop === curProp) {
                    continue;
                } else {
                    prop.selected = true;
                    for (var y = 1; y <= prop.numKeys; y += 1) {
                        prop.setSelectedAtKey(y, false);
                    }
                    var keys = propsObj[i].keys;
                    for (var y = 0; y < keys.length; y += 1) {
                        prop.setSelectedAtKey(keys[y], true);
                    }
                }
            }
        }
        //错帧
        function getTimeOfLeftmostLayer(layers) {
            var time = layers[0].inPoint;
            var index = 0;
            for (var i = 0; i < layers.length; i += 1) {
                if (layers[i].inPoint < time) {
                    time = layers[i].inPoint;
                    index = i;
                } else {
                    continue;
                }
            }
            var arr = [time, index];
            return arr;
        }
        //错帧
        function isLayersInSequence(layers, step) {
            if (layers.length === 2) {
                return true;
            }
            for (var i = 0; i < (layers.length - (2 * step)); i = i + step) {
                var n = Math.round(timeToFrames(layers[i].inPoint) - timeToFrames(layers[i + step].inPoint));
                var n1 = Math.round(timeToFrames(layers[i + step].inPoint) - timeToFrames(layers[i + (2 * step)].inPoint));
                if (n === n1) {
                    continue;
                } else {
                    return false;
                }
            }
            return true;
        }
        //错帧
        function arrangeLayersToTime(layers, time) {
            for (var i = 0; i < layers.length; i += 1) {
                layers[i].startTime = time - getStartTimeOffset(layers[i]);
            }
            return layers;
        }

        function getStartTimeOffset(layer) {
            return layer.inPoint - layer.startTime;
        }
    
        //错帧
        function hasSelectedKeys(props, alt) {
            if (props.length === 0) {
                return false;
            }
            var propsWithKeys = 0;
            for (var y = 0; y < props.length; y += 1) {
                if (props[y].canVaryOverTime === false || props[y].selectedKeys === undefined || props[y].selectedKeys === null) {

                    continue;
                }
                if (props[y].selectedKeys.length > 0) {
                    propsWithKeys++;
                    if (propsWithKeys > 1) {
                        return true;
                    }
                }
            }
            if (propsWithKeys === 1 && alt === 4) {
                return true;
            } else {
                if (propsWithKeys === 1) {
                    return 2;
                }
            }
            return false;
        }
    
        //错帧
        function sortLayersForSeq(layers, order) {
            layers.sort(function(a, b) {
                if (a.index > b.index) {
                    return 1;
                }
                if (a.index < b.index) {
                    return -1;
                }
                return 0;
            });
            if (order === 2) {
                layers.reverse();
            }
            if (order === 3) {
                layers.shuffle();
            }
            return layers;
        }

        //粘贴关键帧
        function pasteKeyframes(comp, alt) {
            if (comp instanceof CompItem) {
                var curTime = comp.time;
                var selProps = getOnlyPropsWithKey(comp.selectedProperties);
                var earliestTime = findSmallestValue(selProps, alt);
                if (earliestTime === curTime && alt !== 2) {
                    alert("Move playhead to clone keyframes");
                    return;
                }
                var propsAndTimes = getPropKeyTimes(selProps);
                for (var i = 0; i < propsAndTimes.length; i += 1) {
                    var curProp = propsAndTimes[i].prop;
                    var times = propsAndTimes[i].times;
                    var rovingKeys = [];
                    var newTimes = [];
                    for (var j = 0; j < times.length; j += 1) {
                        if (curProp.propertyValueType === PropertyValueType.SHAPE) {
                            var maskBezier = curProp.parentProperty.rotoBezier;
                            if (maskBezier === true) {
                                curProp.parentProperty.rotoBezier = false;
                            }
                        }
                        var maskBezier = false;
                        if (alt === 2) {
                            var timeOffset = earliestTime - times[j];
                        } else {
                            var timeOffset = times[j] - earliestTime;
                        }
                        var newTime = curTime + timeOffset;
                        newTimes.push(newTime);
                        var newKeyIndex = curProp.addKey(newTime);
                        var curKeyIndex = curProp.nearestKeyIndex(times[j]);
                        curProp.setValueAtKey(newKeyIndex, curProp.keyValue(curKeyIndex));
                        if (curProp.propertyValueType == PropertyValueType.SHAPE) {
                            if (maskBezier) {
                                curProp.parentProperty.rotoBezier = true;
                            }
                        }
                        var isKeyHasRoving = getKeyframeProperties(curProp, curKeyIndex, newKeyIndex, alt);
                        if (isKeyHasRoving !== null) {
                            rovingKeys.push(isKeyHasRoving);
                        }
                    }
                    if (alt === 1) {
                        propsAndTimes[i].times = propsAndTimes[i].times.concat(newTimes);
                    }
                    if (rovingKeys.length > 0) {
                        for (var y = 0; y < rovingKeys.length; y += 1) {
                            curProp.setRovingAtKey(rovingKeys[y], true);
                        }
                    }
                }
                selectKeys(propsAndTimes);
            }
        }


        function getKeyframeProperties(prop, copyKeyIndex, pasteKeyIndex, reverse) {
            var keyProps = [];
            var propertyType = prop.propertyValueType;
            keyProps.push(prop.isInterpolationTypeValid(KeyframeInterpolationType.LINEAR));
            keyProps.push(prop.isInterpolationTypeValid(KeyframeInterpolationType.BEZIER));
            keyProps.push(prop.isInterpolationTypeValid(KeyframeInterpolationType.HOLD));
            keyProps.keyInTemporalEase = prop.keyInTemporalEase(copyKeyIndex);
            keyProps.keyOutTemporalEase = prop.keyOutTemporalEase(copyKeyIndex);
            keyProps.keyTemporalContinuous = prop.keyTemporalContinuous(copyKeyIndex);
            keyProps.keyTemporalAutoBezier = prop.keyTemporalAutoBezier(copyKeyIndex);
            if (prop.isInterpolationTypeValid(KeyframeInterpolationType.LINEAR) && prop.isInterpolationTypeValid(KeyframeInterpolationType.BEZIER)) {
                if (reverse === 2) {
                    prop.setTemporalEaseAtKey(pasteKeyIndex, keyProps.keyOutTemporalEase, keyProps.keyInTemporalEase);
                } else {
                    prop.setTemporalEaseAtKey(pasteKeyIndex, keyProps.keyInTemporalEase, keyProps.keyOutTemporalEase);
                }
            }
            prop.setTemporalContinuousAtKey(pasteKeyIndex, keyProps.keyTemporalContinuous);
            prop.setTemporalAutoBezierAtKey(pasteKeyIndex, keyProps.keyTemporalAutoBezier);
            keyProps.keyInInterpolationType = prop.keyInInterpolationType(copyKeyIndex);
            keyProps.keyOutInterpolationType = prop.keyOutInterpolationType(copyKeyIndex);
            if (reverse === 2) {
                prop.setInterpolationTypeAtKey(pasteKeyIndex, keyProps.keyOutInterpolationType, keyProps.keyInInterpolationType);
            } else {
                prop.setInterpolationTypeAtKey(pasteKeyIndex, keyProps.keyInInterpolationType, keyProps.keyOutInterpolationType);
            }
            if (propertyType == PropertyValueType.TwoD_SPATIAL || propertyType == PropertyValueType.ThreeD_SPATIAL) {
                keyProps.keyInSpatialTangent = prop.keyInSpatialTangent(copyKeyIndex);
                keyProps.keyOutSpatialTangent = prop.keyOutSpatialTangent(copyKeyIndex);
                keyProps.keySpatialContinuous = prop.keySpatialContinuous(copyKeyIndex);
                keyProps.keySpatialAutoBezier = prop.keySpatialAutoBezier(copyKeyIndex);
                if (reverse === 2) {
                    prop.setSpatialTangentsAtKey(pasteKeyIndex, keyProps.keyOutSpatialTangent, keyProps.keyInSpatialTangent);
                } else {
                    prop.setSpatialTangentsAtKey(pasteKeyIndex, keyProps.keyInSpatialTangent, keyProps.keyOutSpatialTangent);
                }
                prop.setSpatialContinuousAtKey(pasteKeyIndex, keyProps.keySpatialContinuous);
                prop.setSpatialAutoBezierAtKey(pasteKeyIndex, keyProps.keySpatialAutoBezier);
                if (prop.keyRoving(copyKeyIndex) === true) {
                    return pasteKeyIndex;
                } else {
                    return null;
                }
            }
            return null;
        }

        function getOnlyPropsWithKey(props) {
            for (var i = props.length - 1; i >= 0; i--) {
                if (props[i].propertyType === PropertyType.INDEXED_GROUP || props[i].propertyType === PropertyType.NAMED_GROUP) {
                    continue;
                }
                if (props[i].selectedKeys.length === 0 || props[i].canVaryOverTime === false || props[i].enabled === false) {
                    props[i].selected = false;
                    props.splice(i, 1);
                }
            }
            return props;
        }

        function findSmallestValue(props, order) {
            for (var i = 0; i < props.length; i += 1) {
                var curProp = props[i];
                if (curProp.selectedKeys !== undefined) {
                    var keyIndicies = sortNumbers(curProp.selectedKeys);
