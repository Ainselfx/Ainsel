        var workingLayer1 = theSelectedLayers[sss];
        if (workingLayer1 instanceof TextLayer) {
            var WSP = workingLayer1.transform("ADBE Scale").value;
            var IP = workingLayer1.inPoint;
            var OP = workingLayer1.outPoint;
            workingLayer1.selected = true;
            app.executeCommand(3781);
            var workingLayer = comp.selectedLayers[0];
            var contents = workingLayer.property("Contents");
            var layers = [];
            var layersP1 = [];
            var layersP2 = [];
            var layersA1 = [];
            var layersA2 = [];
            for (var i = contents.numProperties - 1; i > 0; i--) {
                var s = comp.selectedLayers[0].duplicate();
                s.selected = true;
            }
            var layers = comp.selectedLayers;
            var curTime = comp.time;
            for (var i2 = 0; i2 < layers.length; i2 += 1) {
                layers[i2].enabled = false;
                var CCC = layers[i2].property("Contents");
                for (var i22 = CCC.numProperties; i22 > 0; i22--) {
                    if (i22 != (i2 + 1)) {
                        CCC.property(i22).remove();
                    }
                }
                var RR = layers[i2].transform("ADBE Rotate Z").value;
                var layerAnchor = layers[i2].transform("ADBE Anchor Point").value;
                var x = layers[i2].sourceRectAtTime(curTime, false).width / 2;
                var y = layers[i2].sourceRectAtTime(curTime, false).height / 2;
                x += layers[i2].sourceRectAtTime(curTime, false).left;
                y += layers[i2].sourceRectAtTime(curTime, false).top;
                var xAdd = (x - layerAnchor[0]) * (WSP[0] / 100);
                var yAdd = (y - layerAnchor[1]) * (WSP[1] / 100);
                var RC = Math.cos(RR * (Math.PI / 180));
                var RS = Math.sin(RR * (Math.PI / 180));
                var layerPosition = layers[i2].position.value;
                layersA1.push(x);
                layersA2.push(y);
                layersP1.push((layerPosition[0] + (xAdd * RC)) - (yAdd * RS));
                layersP2.push(layerPosition[1] + (xAdd * RS) + (yAdd * RC));
            }
            var txt = theSelectedLayers[sss].text.sourceText.value.toString();
            txt = txt.replace(/\r?\n/g, "");
