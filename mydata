        return labels[faceIndex];
    }

    function cubePointLabel(point) {
        var parts = [];
        if (point[2] === 0) { parts.push("\u524d"); }
        else if (point[2] === 1) { parts.push("\u540e"); }
        if (point[0] === 0) { parts.push("\u5de6"); }
        else if (point[0] === 1) { parts.push("\u53f3"); }
        if (point[1] === 0) { parts.push("\u4e0a"); }
        else if (point[1] === 1) { parts.push("\u4e0b"); }

        if (parts.length === 0) {
            return "\u7f51\u683c\u6b63\u4e2d\u5fc3";
        }
        if (parts.length === 1) {
            return parts[0] + "\u9762\u4e2d\u5fc3";
        }
        if (parts.length === 2) {
            return parts.join(" \u00b7 ") + " \u68f1\u4e2d\u70b9";
        }
        return parts.join(" \u00b7 ") + " \u89d2\u70b9";
    }

    function createCubePoints() {
        var values = [0, 0.5, 1];
        var result = [];
        for (var z = 0; z < values.length; z++) {
            for (var y = 0; y < values.length; y++) {
                for (var x = 0; x < values.length; x++) {
                    var normalized = [values[x], values[y], values[z]];
                    result.push({ normalized: normalized, label: cubePointLabel(normalized) });
                }
            }
        }
        return result;
    }

    function projectCubePoint(view, point) {
        var width = view.size[0];
        var height = view.size[1];
        var usable = Math.min((width - 30) / 1.45, (height - 24) / 1.35);
        if (usable < 60) {
            usable = 60;
        }
        var xSpan = usable;
        var ySpan = usable;
        var zShiftX = usable * 0.46;
        var zShiftY = usable * 0.34;
        return [
            width * 0.5 + (point[0] - 0.5) * xSpan + (point[2] - 0.5) * zShiftX,
            height * 0.52 + (point[1] - 0.5) * ySpan - (point[2] - 0.5) * zShiftY
        ];
    }

    function drawCubeSegment(view, graphics, start, end, pen) {
        var a = projectCubePoint(view, start);
        var b = projectCubePoint(view, end);
        graphics.newPath();
        graphics.moveTo(a[0], a[1]);
        graphics.lineTo(b[0], b[1]);
        graphics.strokePath(pen);
    }

    function nearestCubePoint(view, x, y) {
        var bestIndex = -1;
        var bestDistance = 11;
        for (var i = 0; i < view._cubePoints.length; i++) {
            var screen = projectCubePoint(view, view._cubePoints[i].normalized);
            var dx = x - screen[0];
            var dy = y - screen[1];
            var distance = Math.sqrt(dx * dx + dy * dy);
            if (distance < bestDistance) {
                bestDistance = distance;
                bestIndex = i;
            }
        }
        return bestIndex;
    }

