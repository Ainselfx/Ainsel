                        for (var i6 = 1; i6 <= T.transform("ADBE Position").numKeys; i6 += 1) {
                            var TKV2 = T.transform("ADBE Position").keyValue(i6);
                            var TKT2 = T.transform("ADBE Position").keyTime(i6);
                            T.transform("ADBE Position").setValueAtTime(TKT2, [TKV2[0] - PSA1, TKV2[1] - PSA2]);
                        }
                    }
                } else {
                    var tvc2_0 = T.transform("ADBE Position_0").valueAtTime(curTime, true);
                    var tvc2_1 = T.transform("ADBE Position_1").valueAtTime(curTime, true);
                    var PSA1 = tvc2_0 - layersP1[i];
                    var PSA2 = tvc2_1 - layersP2[i];
                    if (layers[i].transform("ADBE Position_0").numKeys == 0) {
                        T.transform("ADBE Position_0").setValue(layersP1[i]);
                    } else {
                        for (var i6 = 1; i6 <= T.transform("ADBE Position_0").numKeys; i6 += 1) {
                            var TKV2 = T.transform("ADBE Position_0").keyValue(i6);
                            var TKT2 = T.transform("ADBE Position_0").keyTime(i6);
                            T.transform("ADBE Position_0").setValueAtTime(TKT2, TKV2 - PSA1);
                        }
                    }
                    if (layers[i].transform("ADBE Position_1").numKeys == 0) {
                        T.transform("ADBE Position_1").setValue(layersP2[i]);
                    } else {
                        for (var i6 = 1; i6 <= T.transform("ADBE Position_1").numKeys; i6 += 1) {
                            var TKV2 = T.transform("ADBE Position_1").keyValue(i6);
                            var TKT2 = T.transform("ADBE Position_1").keyTime(i6);
                            T.transform("ADBE Position_1").setValueAtTime(TKT2, TKV2 - PSA2);
                        }
                    }
                }
                T.inPoint = IP;
                T.outPoint = OP;
                T.moveAfter(workingLayer1);
                TL.push(T);
            }
            workingLayer1.moveAfter(TL[0]);
            for (var i = 0; i < layers.length; i += 1) {
                layers[i].remove();
            }
            for (var sss1 = 0; sss1 < comp.selectedLayers.length; sss1 += 1) {
                comp.selectedLayers[sss1].selected = false;
            }
        }
    }
    app.endUndoGroup();
